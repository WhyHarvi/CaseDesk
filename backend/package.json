{
  "name": "casedesk-backend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/free-port.js && prisma generate && prisma migrate deploy",
    "dev": "nodemon --ignore storage/** src/server.js",
    "prestart": "prisma generate && prisma migrate deploy",
    "start": "node src/server.js",
    "prisma:validate": "prisma validate",
    "db:seed": "node prisma/seed.js",
    "db:seed:chk": "node prisma/seed-chk.js",
    "storage:configure": "node scripts/configure-storage.js",
    "storage:migrate-local": "node scripts/migrate-local-storage.js --apply",
    "storage:migrate-local:dry-run": "node scripts/migrate-local-storage.js",
    "case-info:backfill": "node scripts/backfillCaseInformationProfiles.js --apply",
    "case-info:backfill:dry-run": "node scripts/backfillCaseInformationProfiles.js",
    "case-easy:import": "node scripts/importCaseEasyData.js --apply",
    "case-easy:import:dry-run": "node scripts/importCaseEasyData.js",
    "case-easy:report": "node scripts/importCaseEasyReport.js --apply",
    "case-easy:report:dry-run": "node scripts/importCaseEasyReport.js",
    "booking-invoices:backfill": "node scripts/backfillBookingInvoiceNumbers.js --apply",
    "booking-invoices:backfill:dry-run": "node scripts/backfillBookingInvoiceNumbers.js",
    "abandoned-leads:backfill": "node scripts/backfillAbandonedBookingLeads.js --apply",
    "abandoned-leads:backfill:dry-run": "node scripts/backfillAbandonedBookingLeads.js",
    "test": "node --test test/**/*.test.js",
    "load:test:intake": "node scripts/load-test-lead-intake.js"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.0",
    "@prisma/client": "^6.12.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "imapflow": "^1.4.7",
    "jose": "^6.2.8",
    "libphonenumber-js": "^1.13.8",
    "mailparser": "^3.9.14",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "pdfkit": "^0.19.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.10",
    "prisma": "^6.12.0"
  }
}
