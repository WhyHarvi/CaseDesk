PORT=5001
NODE_ENV=production
FRONTEND_URL=http://localhost:5173
BOOKING_PUBLIC_ORIGIN=https://casedesk.chkimmigration.ca
API_PUBLIC_URL=https://api.example.com
TRUST_PROXY_HOPS=1
JSON_BODY_LIMIT=1mb
LEAD_INTAKE_POLL_MS=2000
LEAD_INTAKE_BATCH_SIZE=10
META_GRAPH_API_BASE_URL=https://graph.facebook.com

# Local CaseDesk AI. For production/live backends, point OLLAMA_BASE_URL at the
# tunnel URL that forwards to your laptop's Ollama service.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_MS=45000
# Optional if your tunnel/proxy requires a static header before forwarding.
OLLAMA_AUTH_HEADER=
OLLAMA_AUTH_VALUE=
# Optional for Cloudflare Access service-token protected tunnels.
OLLAMA_CF_ACCESS_CLIENT_ID=
OLLAMA_CF_ACCESS_CLIENT_SECRET=

# 32-byte base64 or 64-character hex key used to encrypt agency mailbox passwords.
# Generate once with: openssl rand -base64 32
MAIL_SETTINGS_ENCRYPTION_KEY=REPLACE_WITH_A_PRIVATE_32_BYTE_KEY

# Microsoft 365 personal and workspace system mailboxes. Register a Web app in
# Microsoft Entra ID and add the callback URL below as an exact Web redirect URI.
MS_MAIL_CLIENT_ID=your-microsoft-entra-application-client-id
MS_MAIL_CLIENT_SECRET=your-microsoft-entra-client-secret
MS_MAIL_TENANT_ID=organizations
MS_MAIL_REDIRECT_URI=https://your-backend-domain/api/mailboxes/microsoft/callback

# Runtime connection used by the Express app and Prisma Client.
# Use the Supabase pooler / Supavisor URL here.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true

# Direct database connection used by Prisma CLI commands such as:
# npx prisma db push
# npx prisma migrate dev
# npx prisma studio
DIRECT_URL=postgresql://postgres:YOUR_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

# Server-only Supabase Auth settings. Never expose the service-role key to Vite.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=REPLACE_WITH_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVICE_ROLE_KEY
SUPABASE_DOCUMENT_BUCKET=case-files
SUPABASE_AVATAR_BUCKET=profile-avatars

# Local demo seed password (minimum 10 characters). Keep this out of production.
DEMO_PASSWORD=

# QuickBooks Online (Intuit developer app credentials)
QBO_CLIENT_ID=your-intuit-app-client-id
QBO_CLIENT_SECRET=your-intuit-app-client-secret
QBO_REDIRECT_URI=https://your-backend-domain/api/quickbooks/callback
QBO_ENVIRONMENT=sandbox
# Webhook Verifier Token from Intuit's developer dashboard (separate from
# the client secret) — required to verify the /api/quickbooks/webhook endpoint.
QBO_WEBHOOK_VERIFIER_TOKEN=your-intuit-webhook-verifier-token

# Zoom General OAuth app (admin-managed)
ZOOM_CLIENT_ID=your-zoom-app-client-id
ZOOM_CLIENT_SECRET=your-zoom-app-client-secret
ZOOM_REDIRECT_URI=https://your-backend-domain/api/zoom/callback
# Secret token from the Zoom app's Event Subscriptions page.
ZOOM_WEBHOOK_SECRET_TOKEN=your-zoom-webhook-secret-token
