enum AppointmentAdviceOutcome {
  PENDING
  PROCEEDING
  CONSIDERING
  DECLINED
}

// A consultant's post-consultation recommendation, handed off to whoever
// should make the follow-up call — one row per appointment. adviceText and
// categories are the consultant's original words and are never rewritten
// after creation; only assignedUserId/followUpDate (the handoff itself) are
// editable, and every reassignment is separately logged via LeadActivity/
// LeadAssignmentHistory (through moveLeadOwnership) so the original advice
// is never lost even if the handoff changes hands.
model AppointmentAdvice {
  id                  String                   @id @default(uuid())
  agencyId            String                   @map("agency_id")
  appointmentId       String                   @unique @map("appointment_id")
  leadId              String?                  @map("lead_id")
  clientId            String?                  @map("client_id")
  consultantUserId    String                   @map("consultant_user_id")
  assignedUserId      String                   @map("assigned_user_id")
  // Extra consultants assigned alongside assignedUserId (the primary — the
  // one lead ownership and the handoff follow-up task go to, so there's
  // never more than one owner of "call the client"). These get the same
  // notification and see the same handoff card, but aren't the task owner.
  additionalAssignedUserIds String[]           @default([]) @map("additional_assigned_user_ids")
  categories          String[]
  adviceText          String                   @map("advice_text")
  followUpDate        DateTime                 @map("follow_up_date")
