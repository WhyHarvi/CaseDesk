// Idempotency anchor for the incentive-crediting engine — never exposed via
// API. Four different call sites can each observe a CaseInvoice's balance
// move (manual payment, QuickBooks webhook, the read-path resync in
// listCaseInvoices, and the installment-void no-op); this cursor is the one
// source of truth for "how much of this invoice's balance drop has already
// been credited", claimed with a compare-and-swap so none of them can
// double-credit the same collection.
model CaseInvoiceCreditCursor {
  id                  String      @id @default(uuid())
  agencyId            String      @map("agency_id")
  caseInvoiceId       String      @unique @map("case_invoice_id")
  lastCreditedBalance Decimal     @map("last_credited_balance") @db.Decimal(10, 2)
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")
  agency              Agency      @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  caseInvoice         CaseInvoice @relation(fields: [caseInvoiceId], references: [id], onDelete: Cascade)

  @@map("case_invoice_credit_cursors")
}

// Frozen when the invoice is created. Payments against this invoice keep
// using the people and plan captured here even if the case is transferred.
model CaseInvoiceIncentiveSnapshot {
  id              String         @id @default(uuid())
  agencyId        String         @map("agency_id")
  caseInvoiceId   String         @unique @map("case_invoice_id")
  incentivePlanId String?        @map("incentive_plan_id")
  planName        String?        @map("plan_name")
  planVersion     Int?           @map("plan_version")
  formulaType     String?        @map("formula_type")
  flatAmount      Decimal?       @map("flat_amount") @db.Decimal(10, 2)
  percentRate     Decimal?       @map("percent_rate") @db.Decimal(5, 2)
  tiers           Json
  recipients      Json
  createdAt       DateTime       @default(now()) @map("created_at")
  agency          Agency         @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  caseInvoice     CaseInvoice    @relation(fields: [caseInvoiceId], references: [id], onDelete: Cascade)
  incentivePlan   IncentivePlan? @relation(fields: [incentivePlanId], references: [id], onDelete: Restrict)

  @@index([agencyId])
  @@map("case_invoice_incentive_snapshots")
}

// One frozen, immutable row per (payment collection event, credited
// person). No update/delete endpoint is ever exposed for this model —
// editing a plan's formula or a role's name later must never rewrite what
// someone already earned, so every value that could otherwise drift is
// snapshotted here at credit time rather than derived live from the
// current plan/role state.
model IncentiveLedgerEntry {
  id                      String                          @id @default(uuid())
  agencyId                String                          @map("agency_id")
  caseId                  String                          @map("case_id")
  // Null for a TIMELINE_BONUS row — a timeline bonus (e.g. "reached
  // Qualified") has no invoice at all. Every other entryType still requires
  // one; that's enforced in incentiveCreditingService, not the database.
  caseInvoiceId           String?                         @map("case_invoice_id")
  timelineLegEvaluationId String?                         @map("timeline_leg_evaluation_id")
  incentivePlanId         String                          @map("incentive_plan_id")
  userId                  String                          @map("user_id")
  attributionKind         String                          @map("attribution_kind")
  caseRoleId              String?                         @map("case_role_id")
  roleNameSnapshot        String                          @map("role_name_snapshot")
  sharePercentApplied     Decimal                         @map("share_percent_applied") @db.Decimal(5, 2)
  sourceAmountCollected   Decimal                         @map("source_amount_collected") @db.Decimal(10, 2)
  creditedAmount          Decimal                         @map("credited_amount") @db.Decimal(10, 2)
  triggerSource           String                          @map("trigger_source")
  triggerRef              String?                         @map("trigger_ref")
  entryType               String                          @default("CREDIT") @map("entry_type")
  reversesEntryId         String?                         @map("reverses_entry_id")
  creditedAt              DateTime                        @map("credited_at")
  createdAt               DateTime                        @default(now()) @map("created_at")
  agency                  Agency                          @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  case                    Case                            @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseInvoice             CaseInvoice?                    @relation(fields: [caseInvoiceId], references: [id], onDelete: Cascade)
  timelineLegEvaluation   IncentiveTimelineLegEvaluation? @relation(fields: [timelineLegEvaluationId], references: [id], onDelete: Restrict)
  incentivePlan           IncentivePlan                   @relation(fields: [incentivePlanId], references: [id], onDelete: Restrict)
  user                    User                            @relation(fields: [userId], references: [id], onDelete: Restrict)
  caseRole                AgencyCaseRole?                 @relation(fields: [caseRoleId], references: [id], onDelete: SetNull)
  reversesEntry           IncentiveLedgerEntry?           @relation("IncentiveLedgerReversal", fields: [reversesEntryId], references: [id], onDelete: Restrict)
  reversalEntries         IncentiveLedgerEntry[]          @relation("IncentiveLedgerReversal")

  @@index([agencyId, userId, creditedAt])
  @@index([agencyId, caseId])
  @@index([agencyId, caseInvoiceId])
  @@index([agencyId, creditedAt])
  @@index([reversesEntryId])
  @@map("incentive_ledger_entries")
}

// One frozen row per (case, leg) — the leg's own idempotency + audit
// record. Written whether the leg was actually credited or missed, so
// "why didn't this pay out" is answerable without reverse-engineering it
// from an absence of ledger rows. legId/matchedTierId are deliberately
// plain columns, NOT foreign keys: IncentivePlanTimelineLeg/Tier rows are
// deleted and recreated whole on every plan save, so a hard FK would break
// the first plan edit made after any case has ever been evaluated.
// incentivePlanId IS a real FK — plans themselves are never
// deleted-and-recreated the way their legs are.
model IncentiveTimelineLegEvaluation {
  id                String                 @id @default(uuid())
  agencyId          String                 @map("agency_id")
  caseId            String                 @map("case_id")
  legId             String                 @map("leg_id")
  legNameSnapshot   String                 @map("leg_name_snapshot")
  incentivePlanId   String                 @map("incentive_plan_id")
  fromCheckpointAt  DateTime               @map("from_checkpoint_at")
  toCheckpointAt    DateTime               @map("to_checkpoint_at")
  elapsedMinutes    Int                    @map("elapsed_minutes")
  matchedTierId     String?                @map("matched_tier_id")
  multiplierPercent Decimal?               @map("multiplier_percent") @db.Decimal(5, 2)
  baseBonusAmount   Decimal                @map("base_bonus_amount") @db.Decimal(10, 2)
  creditedTotal     Decimal                @map("credited_total") @db.Decimal(10, 2)
  outcome           String
  evaluatedAt       DateTime               @default(now()) @map("evaluated_at")
  agency            Agency                 @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  case              Case                   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  incentivePlan     IncentivePlan          @relation(fields: [incentivePlanId], references: [id], onDelete: Restrict)
  ledgerEntries     IncentiveLedgerEntry[]

  @@unique([caseId, legId])
  @@index([agencyId, caseId])
  @@map("incentive_timeline_leg_evaluations")
}

// A lightweight, QuickBooks-independent record of money owed/received on a
// case — for amounts staff deliberately don't want flowing into the
// QuickBooks-synced CaseInvoice/CasePaymentInstallment pipeline above (e.g.
// historical admissions fees migrated from an outside spreadsheet). Just
// enough to answer "what came in and what's still owed" without pretending
// to be a real accounting record.
// Attaches to either a Lead (pre-conversion) or a Case+Client (post-
// conversion) — never both. caseId/clientId used to be required back when
// this only tracked converted-client fees; leadId was added so staff can
// start recording "what's paid, what's still owed" during the lead stage
// too, before there's a Case to hang it off of.
model CaseManualLedgerEntry {
  id                String       @id @default(uuid())
  agencyId          String       @map("agency_id")
  leadId            String?      @map("lead_id")
  caseId            String?      @map("case_id")
  clientId          String?      @map("client_id")
  label             String
  amountOwed        Decimal      @default(0) @map("amount_owed") @db.Decimal(10, 2)
  amountPaid        Decimal      @default(0) @map("amount_paid") @db.Decimal(10, 2)
  status            String       @default("Unpaid")
  note              String?
  createdById       String?      @map("created_by_id")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")
  // Set once scripts/migrateManualLedgerToCashLedger.js has recreated this
  // entry as a real CaseDeskCash CaseInvoice (+ CashTransaction/Allocation
  // for whatever was already paid). Lets the Payments-tab "needs
  // classification" review queue drop a row once it's been moved into the
  // real cash ledger, without deleting the original record.
  migratedInvoiceId String?      @map("migrated_invoice_id")
  migratedAt        DateTime?    @map("migrated_at")
  agency            Agency       @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  lead              Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  case              Case?        @relation(fields: [caseId], references: [id], onDelete: Cascade)
  client            Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy         User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  migratedInvoice   CaseInvoice? @relation("ManualLedgerMigratedInvoice", fields: [migratedInvoiceId], references: [id], onDelete: SetNull)

  @@index([agencyId, leadId])
  @@index([agencyId, caseId])
  @@index([agencyId, clientId])
  @@map("case_manual_ledger_entries")
}

