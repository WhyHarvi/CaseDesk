  createdById            String?                  @map("created_by_id")
  cancelledById          String?                  @map("cancelled_by_id")
  cancelledAt            DateTime?                @map("cancelled_at")
  cancellationReason     String?                  @map("cancellation_reason")
  source                 String                   @default("Internal")
  isFreeConsultation     Boolean                  @default(false) @map("is_free_consultation")
  idempotencyKey         String?                  @map("idempotency_key")
  referenceCode          String?                  @unique @map("reference_code")
  confirmationStatus     String                   @default("Awaiting") @map("confirmation_status")
  confirmedAt            DateTime?                @map("confirmed_at")
  preparationCompletedAt DateTime?                @map("preparation_completed_at")
  seriesKey              String?                  @map("series_key")
  recurrenceIndex        Int?                     @map("recurrence_index")
  recurrenceCount        Int?                     @map("recurrence_count")
  status                 AppointmentStatus        @default(Scheduled)
  createdAt              DateTime                 @default(now()) @map("created_at")
  updatedAt              DateTime                 @updatedAt @map("updated_at")
  agency                 Agency                   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  client                 Client?                  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  case                   Case?                    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  lead                   Lead?                    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  sessionType            BookingSessionType?      @relation(fields: [sessionTypeId], references: [id], onDelete: SetNull)
  assignedTo             User?                    @relation("AssignedAppointmentUser", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy              User?                    @relation("CreatedAppointmentUser", fields: [createdById], references: [id], onDelete: SetNull)
  cancelledBy            User?                    @relation("CancelledAppointmentUser", fields: [cancelledById], references: [id], onDelete: SetNull)
  leadConsultation       LeadConsultation?
  messageDeliveries      BookingMessageDelivery[]
  events                 AppointmentEvent[]
  notes                  Note[]
  followUps              FollowUp[]
  paymentHold            BookingPaymentHold?
  meetingJobs            AppointmentMeetingJob[]

  @@unique([agencyId, idempotencyKey])
  @@index([agencyId])
  @@index([caseId, startsAt])
  @@index([clientId])
  @@index([assignedToId, startsAt])
  @@index([agencyId, startsAt])
  @@index([agencyId, status, startsAt])
  @@index([agencyId, reminderDueAt, reminderQueuedAt])
  @@index([leadId])
  @@index([agencyId, seriesKey, recurrenceIndex])
  @@index([agencyId, confirmationStatus, startsAt])
  @@index([agencyId, meetingProvider, meetingProviderId])
  @@map("appointments")
}

