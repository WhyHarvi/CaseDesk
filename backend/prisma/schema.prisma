  leadDays        Int                                @default(183) @map("lead_days")
  cadenceDays     Int                                @default(30) @map("cadence_days")
  maxReminders    Int                                @default(1) @map("max_reminders")
  emailEnabled    Boolean                            @default(true) @map("email_enabled")
  smsEnabled      Boolean                            @default(false) @map("sms_enabled")
  subjectTemplate String                             @map("subject_template")
  messageTemplate String                             @map("message_template")
  smsTemplate     String                             @map("sms_template")
  createdAt       DateTime                           @default(now()) @map("created_at")
  updatedAt       DateTime                           @updatedAt @map("updated_at")
  agency          Agency                             @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  deliveries      ExpiringDocumentReminderDelivery[]

  @@unique([agencyId, documentKey])
  @@index([agencyId, enabled])
  @@map("expiring_document_reminder_policies")
}

model ExpiringDocumentReminderDelivery {
  id            String                         @id @default(uuid())
  agencyId      String                         @map("agency_id")
  policyId      String                         @map("policy_id")
  targetKey     String                         @map("target_key")
  clientId      String                         @map("client_id")
