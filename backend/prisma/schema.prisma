  @@unique([agencyId, qbInvoiceId])
  @@unique([agencyId, invoiceNumber])
  @@unique([agencyId, creationIdempotencyKey])
  @@unique([agencyId, lastPaymentIdempotencyKey])
  @@index([agencyId, caseId])
  @@index([agencyId, clientId])
  @@index([agencyId, customLedgerId])
