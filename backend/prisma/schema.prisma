  caseInformationProfiles    CaseInformationProfile[]
  caseFormClientRequests     CaseFormClientRequest[]
  caseFormSignatureRequests  CaseFormSignatureRequest[]
  caseInvoices               CaseInvoice[]
  caseManualLedgerEntries    CaseManualLedgerEntry[]
  paymentSchedules           CasePaymentSchedule[]
  paymentInstallments        CasePaymentInstallment[]
  paymentApprovals           PaymentApproval[]
  cashTransactions           CashTransaction[]
  caseEasyImportContacts     CaseEasyImportContact[]
  caseEasyImportReportRows   CaseEasyImportReportRow[]
  callSessions           CallSession[]
  appointmentAdvice          AppointmentAdvice[]

  @@unique([agencyId, clientNumber])
  @@unique([agencyId, creationIdempotencyKey])
  @@unique([agencyId, phoneNormalized])
  @@unique([agencyId, emailNormalized])
  @@index([agencyId])
  @@index([agencyId, archivedAt])
  @@index([assignedUserId])
  @@index([agencyId, qbCustomerId])
