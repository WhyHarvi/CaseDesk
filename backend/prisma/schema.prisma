// Case profile redesign, Phase 2 — canonical, section-granular replacement
// for CaseAssessment.formData (see backend/src/modules/case-information/).
// Dual-read/dual-write with the legacy JSON blob during migration; nothing
// in the live app reads or writes these yet (Phase 3+). `version` backs a
// real optimistic-concurrency check via the atomic-claim idiom already
// used elsewhere in this codebase (updateMany + check affected-row count),
// not the increment-only counter pattern Lead.version uses.
model ClientInformationProfile {
  id          String   @id @default(uuid())
  agencyId    String   @map("agency_id")
  clientId    String   @map("client_id")
  sectionKey  String   @map("section_key")
  data        Json     @default("{}")
  version     Int      @default(1)
  updatedById String?  @map("updated_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  agency      Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  updatedBy   User?    @relation("ClientInformationProfileUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([agencyId, clientId, sectionKey])
  @@index([agencyId, clientId])
  @@map("client_information_profiles")
}

model CaseInformationProfile {
  id          String   @id @default(uuid())
  agencyId    String   @map("agency_id")
