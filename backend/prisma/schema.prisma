// Staff-to-staff internal messaging (DMs and group threads), kept as its
// own model rather than reusing CommunicationConversation/Message — that
// model is client-centric (single clientId, one unreadCount int, one
// clientLastReadAt) and doesn't fit arbitrary N-party staff membership or
// per-participant read state, which group threads genuinely need.
model InternalChatThread {
  id               String                    @id @default(uuid())
  agencyId         String                    @map("agency_id")
  isGroup          Boolean                   @default(false) @map("is_group")
  name             String?
  avatarStorageKey String?                   @map("avatar_storage_key")
  avatarMimeType   String?                   @map("avatar_mime_type")
  createdById      String                    @map("created_by_id")
  lastMessageAt    DateTime                  @default(now()) @map("last_message_at")
  createdAt        DateTime                  @default(now()) @map("created_at")
  updatedAt        DateTime                  @updatedAt @map("updated_at")
  agency           Agency                    @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  createdBy        User                      @relation("InternalChatThreadCreator", fields: [createdById], references: [id], onDelete: Restrict)
  participants     InternalChatParticipant[]
  messages         InternalChatMessage[]

  @@index([agencyId, lastMessageAt])
  @@map("internal_chat_threads")
}

model InternalChatParticipant {
  id         String             @id @default(uuid())
  agencyId   String             @map("agency_id")
  threadId   String             @map("thread_id")
  userId     String             @map("user_id")
  lastReadAt DateTime?          @map("last_read_at")
  joinedAt   DateTime           @default(now()) @map("joined_at")
  agency     Agency             @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  thread     InternalChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([threadId, userId])
  @@index([userId])
  @@map("internal_chat_participants")
}

model InternalChatMessage {
  id                String                        @id @default(uuid())
  agencyId          String                        @map("agency_id")
  threadId          String                        @map("thread_id")
  senderId          String                        @map("sender_id")
  bodyText          String?                       @map("body_text")
  hasAttachment     Boolean                       @default(false) @map("has_attachment")
  clientMessageId   String?                       @map("client_message_id")
  replyToId         String?                       @map("reply_to_id")
  editedAt          DateTime?                     @map("edited_at")
  occurredAt        DateTime                      @default(now()) @map("occurred_at")
  deletedAt         DateTime?                     @map("deleted_at")
  createdAt         DateTime                      @default(now()) @map("created_at")
  agency            Agency                        @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  thread            InternalChatThread            @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender            User                          @relation("InternalChatMessageSender", fields: [senderId], references: [id], onDelete: Restrict)
  replyTo           InternalChatMessage?          @relation("InternalChatMessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies           InternalChatMessage[]         @relation("InternalChatMessageReplies")
  attachmentRecords InternalChatAttachment[]
  reactions         InternalChatMessageReaction[]

  @@index([threadId, occurredAt])
  @@index([agencyId, threadId, clientMessageId])
  @@map("internal_chat_messages")
