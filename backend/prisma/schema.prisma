// Maps the existing "support_tickets" table (created directly via SQL in
// supportTicketService.js, before this model existed) so the developer
// dashboard can query it with Prisma instead of hand-written raw SQL.
// Column list/types must match that migration exactly — no schema change,
// this is purely giving an existing table a typed model.
model SupportTicket {
  id                   String    @id @default(uuid())
  ticketNumber         String    @unique @map("ticket_number")
  agencyId             String    @map("agency_id")
  reportedById         String    @map("reported_by_id")
  status               String    @default("Submitted")
  description          String
  novaSummary          String?   @map("nova_summary")
  pagePath             String?   @map("page_path")
  errorCode            String?   @map("error_code")
  errorMessage         String?   @map("error_message")
  diagnostics          Json?
  screenshotStorageKey String?   @map("screenshot_storage_key")
  screenshotMimeType   String?   @map("screenshot_mime_type")
  deliveryStatus       String    @default("Pending") @map("delivery_status")
  deliveryError        String?   @map("delivery_error")
  deliveredAt          DateTime? @map("delivered_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at")
  agency               Agency    @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  reportedBy           User      @relation(fields: [reportedById], references: [id], onDelete: Restrict)

  @@index([agencyId, createdAt])
  @@index([status, createdAt])
  @@map("support_tickets")
}

// Small key/value store for developer-portal-controlled feature flags — a
// DB-backed alternative to hardcoded consts like the retainer autosend
// switch, so flipping one doesn't require a code change + deploy. Every
// flag still has a hardcoded default (see featureFlags.js) so a missing
// row behaves exactly like today's hardcoded const.
model DeveloperSetting {
  key         String   @id
  value       String
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")
  updatedById String?  @map("updated_by_id")
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("developer_settings")
}

// Coarse portal-usage tracking for the team workload dashboard — one row
// per (agency, user, calendar day), upserted by a client heartbeat rather
// than one row per ping, so growth stays bounded to active-users × active-
// days instead of active-users × pings.
model UserPortalActivity {
  id            String   @id @default(uuid())
  agencyId      String   @map("agency_id")
  userId        String   @map("user_id")
  activityDate  DateTime @map("activity_date") @db.Date
  activeSeconds Int      @default(0) @map("active_seconds")
  pingCount     Int      @default(0) @map("ping_count")
  firstPingAt   DateTime @map("first_ping_at")
  lastPingAt    DateTime @map("last_ping_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  agency        Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([agencyId, userId, activityDate])
  @@index([agencyId, activityDate])
  @@map("user_portal_activity")
}

model AgencyLeadSequence {
