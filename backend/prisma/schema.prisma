model CommunicationConversation {
  id               String                         @id @default(uuid())
  agencyId         String                         @map("agency_id")
  clientId         String                         @map("client_id")
  caseId           String?                        @map("case_id")
  channel          CommunicationChannel
  subject          String?
  provider         String?
  providerThreadId String?                        @map("provider_thread_id")
  assignedToId     String?                        @map("assigned_to_id")
  state            CommunicationConversationState @default(Open)
  priority         CommunicationPriority          @default(Normal)
  tags             Json                           @default("[]")
  unreadCount      Int                            @default(0) @map("unread_count")
  lastInboundAt    DateTime?                      @map("last_inbound_at")
  firstInboundAt   DateTime?                      @map("first_inbound_at")
  lastOutboundAt   DateTime?                      @map("last_outbound_at")
  snoozedUntil     DateTime?                      @map("snoozed_until")
  responseDueAt    DateTime?                      @map("response_due_at")
  resolutionDueAt  DateTime?                      @map("resolution_due_at")
  firstRespondedAt DateTime?                      @map("first_responded_at")
  lastMessageAt    DateTime                       @default(now()) @map("last_message_at")
  // When the client last had this chat thread open/focused — distinct from
  // isRead (which just means "not from the client") and unreadCount (staff
  // side). Nullable/never-set means "never confirmed read"; used only to
  // render a staff-side read receipt, not for SLA or notification logic.
  clientLastReadAt DateTime?                      @map("client_last_read_at")
  isArchived       Boolean                        @default(false) @map("is_archived")
  legalHold        Boolean                        @default(false) @map("legal_hold")
  deletedAt        DateTime?                      @map("deleted_at")
  deletedById      String?                        @map("deleted_by_id")
  createdById      String                         @map("created_by_id")
  createdAt        DateTime                       @default(now()) @map("created_at")
  updatedAt        DateTime                       @updatedAt @map("updated_at")
  agency           Agency                         @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  client           Client                         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  case             Case?                          @relation(fields: [caseId], references: [id], onDelete: Cascade)
  createdBy        User                           @relation("CreatedCommunicationConversationUser", fields: [createdById], references: [id], onDelete: Restrict)
  assignedTo       User?                          @relation("AssignedCommunicationConversationUser", fields: [assignedToId], references: [id], onDelete: SetNull)
  deletedBy        User?                          @relation("DeletedCommunicationConversationUser", fields: [deletedById], references: [id], onDelete: SetNull)
  messages         CommunicationMessage[]

  @@index([agencyId])
  @@index([caseId, lastMessageAt])
  @@index([clientId])
  @@index([channel])
  @@index([agencyId, state, lastMessageAt])
  @@index([assignedToId, state])
  @@index([agencyId, responseDueAt, state])
  @@index([agencyId, resolutionDueAt, state])
  @@index([deletedAt])
  @@map("communication_conversations")
}

model CommunicationMessage {
