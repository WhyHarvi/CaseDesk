  name          String
  isActive      Boolean   @default(true) @map("is_active")
  sortOrder     Int       @default(0) @map("sort_order")
  // Ordered array of {field, value}, AND'ed together. field is one of:
  // "initialMessage" | "immigrationInterest" (substring match) |
  // "province" | "preferredLanguage" | "priority" | "originalSourceType"
  // (exact match). See matchLeadRoutingRules() for exact semantics.
  conditions    Json      @default("[]")
  matchMode     String    @default("ANY") @map("match_mode")
  targetUserId  String?   @map("target_user_id")
  lastMatchedAt DateTime? @map("last_matched_at")
  matchCount    Int       @default(0) @map("match_count")
  createdById   String    @map("created_by_id")
  updatedById   String    @map("updated_by_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  agency        Agency    @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  targetUser    User?     @relation("LeadRoutingRuleTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)
  createdBy     User      @relation("CreatedLeadRoutingRuleUser", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy     User      @relation("UpdatedLeadRoutingRuleUser", fields: [updatedById], references: [id], onDelete: Restrict)
  backlogReviews LeadRoutingBacklogReview[]

  @@unique([agencyId, name])
  @@index([agencyId, isActive, sortOrder])
  @@map("lead_routing_rules")
}

model LeadRoutingBacklogReview {
