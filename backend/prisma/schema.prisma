model LeadSourceConnection {
  id                     String              @id @default(uuid())
  agencyId               String              @map("agency_id")
  sourceId               String              @map("source_id")
  campaignId             String?             @map("campaign_id")
  ownerUserId            String              @map("owner_user_id")
  provider               String              @default("WEBSITE")
  name                   String
  publicToken            String              @unique @map("public_token")
  signingSecretEncrypted String              @map("signing_secret_encrypted")
  accessTokenEncrypted   String?             @map("access_token_encrypted")
  isActive               Boolean             @default(true) @map("is_active")
  firstResponseMinutes   Int                 @default(15) @map("first_response_minutes")
  allowedOrigins         Json                @default("[]") @map("allowed_origins")
  lastEventAt            DateTime?           @map("last_event_at")
  createdAt              DateTime            @default(now()) @map("created_at")
  updatedAt              DateTime            @updatedAt @map("updated_at")
  agency                 Agency              @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  source                 LeadSource          @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  campaign               LeadCampaign?       @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  owner                  User                @relation("LeadSourceConnectionOwnerUser", fields: [ownerUserId], references: [id], onDelete: Restrict)
  incomingEvents         LeadIncomingEvent[]

  @@unique([agencyId, name])
  @@index([agencyId, provider, isActive])
  @@map("lead_source_connections")
}

model LeadImportBatch {
  id             String                @id @default(uuid())
  agencyId       String                @map("agency_id")
  sourceId       String                @map("source_id")
  uploadedById   String                @map("uploaded_by_id")
  fileName       String                @map("file_name")
  status         LeadImportBatchStatus @default(PREVIEW)
  totalRows      Int                   @default(0) @map("total_rows")
  validRows      Int                   @default(0) @map("valid_rows")
  invalidRows    Int                   @default(0) @map("invalid_rows")
  processedRows  Int                   @default(0) @map("processed_rows")
  duplicateRows  Int                   @default(0) @map("duplicate_rows")
  failedRows     Int                   @default(0) @map("failed_rows")
  settings       Json                  @default("{}")
  committedAt    DateTime?             @map("committed_at")
  completedAt    DateTime?             @map("completed_at")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")
  agency         Agency                @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  source         LeadSource            @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  uploadedBy     User                  @relation("LeadImportUploaderUser", fields: [uploadedById], references: [id], onDelete: Restrict)
  rows           LeadImportRow[]
  incomingEvents LeadIncomingEvent[]

  @@index([agencyId, createdAt])
  @@index([agencyId, status])
  @@map("lead_import_batches")
}

model LeadImportRow {
  id               String              @id @default(uuid())
  agencyId         String              @map("agency_id")
  batchId          String              @map("batch_id")
  rowNumber        Int                 @map("row_number")
  rawData          Json                @map("raw_data")
  normalizedData   Json?               @map("normalized_data")
  validationErrors Json                @default("[]") @map("validation_errors")
  status           LeadImportRowStatus
  createdLeadId    String?             @map("created_lead_id")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")
  agency           Agency              @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  batch            LeadImportBatch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  createdLead      Lead?               @relation("LeadImportCreatedLead", fields: [createdLeadId], references: [id], onDelete: SetNull)
  incomingEvent    LeadIncomingEvent?

  @@unique([batchId, rowNumber])
  @@index([agencyId, status])
  @@map("lead_import_rows")
}

model LeadDuplicateCandidate {
  id              String              @id @default(uuid())
  agencyId        String              @map("agency_id")
  incomingEventId String              @map("incoming_event_id")
  candidateLeadId String              @map("candidate_lead_id")
  score           Int
  reasons         Json                @default("[]")
  status          LeadDuplicateStatus @default(PENDING)
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  agency          Agency              @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  incomingEvent   LeadIncomingEvent   @relation(fields: [incomingEventId], references: [id], onDelete: Cascade)
  candidateLead   Lead                @relation(fields: [candidateLeadId], references: [id], onDelete: Cascade)

  @@unique([incomingEventId, candidateLeadId])
  @@index([agencyId, status, createdAt])
  @@map("lead_duplicate_candidates")
}

model QuestionnaireAssignment {
  id                    String         @id @default(uuid())
  sourceId              String         @map("source_id")
  agencyId              String         @map("agency_id")
  assessmentId          String         @map("assessment_id")
  caseId                String         @map("case_id")
  clientId              String         @map("client_id")
  name                  String
  sharing               String         @default("Internal")
  status                String         @default("Assigned")
  dueAt                 DateTime?      @map("due_at")
  locked                Boolean        @default(false)
  assignedAt            DateTime       @default(now()) @map("assigned_at")
  submittedAt           DateTime?      @map("submitted_at")
  sourceData            Json           @default("{}") @map("source_data")
  // Review-workflow fields (Phase 2 schema, Phase 4 behavior) — schema only
  // for now, nothing writes these yet.
  correctionRequestedAt DateTime?      @map("correction_requested_at")
  correctionNote        String?        @map("correction_note")
  reviewedAt            DateTime?      @map("reviewed_at")
  reviewedById          String?        @map("reviewed_by_id")
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")
  agency                Agency         @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  assessment            CaseAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  case                  Case           @relation(fields: [caseId], references: [id], onDelete: Cascade)
  client                Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  reviewedBy            User?          @relation("QuestionnaireAssignmentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([assessmentId, sourceId])
  @@index([agencyId, status, dueAt])
  @@index([caseId])
  @@index([clientId])
  @@map("questionnaire_assignments")
}

// Case profile redesign, Phase 2 — canonical, section-granular replacement
// for CaseAssessment.formData (see backend/src/modules/case-information/).
// Dual-read/dual-write with the legacy JSON blob during migration; nothing
// in the live app reads or writes these yet (Phase 3+). `version` backs a
// real optimistic-concurrency check via the atomic-claim idiom already
// used elsewhere in this codebase (updateMany + check affected-row count),
// not the increment-only counter pattern Lead.version uses.
model ClientInformationProfile {
  id          String   @id @default(uuid())
  agencyId    String   @map("agency_id")
  clientId    String   @map("client_id")
  sectionKey  String   @map("section_key")
  data        Json     @default("{}")
  version     Int      @default(1)
  updatedById String?  @map("updated_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  agency      Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  updatedBy   User?    @relation("ClientInformationProfileUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([agencyId, clientId, sectionKey])
  @@index([agencyId, clientId])
  @@map("client_information_profiles")
}

model CaseInformationProfile {
  id          String   @id @default(uuid())
  agencyId    String   @map("agency_id")
  caseId      String   @map("case_id")
  clientId    String   @map("client_id")
  sectionKey  String   @map("section_key")
  data        Json     @default("{}")
  version     Int      @default(1)
  updatedById String?  @map("updated_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  agency      Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  case        Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  updatedBy   User?    @relation("CaseInformationProfileUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([agencyId, caseId, sectionKey])
  @@index([agencyId, caseId])
  @@map("case_information_profiles")
}

// Explicit state only — not-applicable overrides and verification. Never
// stores calculated completion/status; that's always derived (see
// sectionCompletionService.js) so it can never drift out of sync with
// the data it's describing.
model CaseInformationSectionState {
  id                  String    @id @default(uuid())
  agencyId            String    @map("agency_id")
  caseId              String    @map("case_id")
  sectionKey          String    @map("section_key")
  // Manual assignment (Phase 6): optional/not_applicable sections are
  // hidden by default until explicitly enabled for this case, or until
  // they already carry real data — see
  // caseInformationWorkspace.js's isSectionVisible(). Required sections
  // ignore this flag entirely; they always show.
  enabled             Boolean   @default(false)
  enabledAt           DateTime? @map("enabled_at")
  enabledById         String?   @map("enabled_by_id")
  notApplicable       Boolean   @default(false) @map("not_applicable")
  notApplicableReason String?   @map("not_applicable_reason")
  verifiedAt          DateTime? @map("verified_at")
  verifiedById        String?   @map("verified_by_id")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  agency              Agency    @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  case                Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  verifiedBy          User?     @relation("CaseInformationSectionStateVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  enabledBy           User?     @relation("CaseInformationSectionStateEnabler", fields: [enabledById], references: [id], onDelete: SetNull)

  @@unique([agencyId, caseId, sectionKey])
  @@map("case_information_section_states")
}

model Notification {
  id              String                 @id @default(uuid())
  agencyId        String                 @map("agency_id")
  recipientUserId String                 @map("recipient_user_id")
  actorUserId     String?                @map("actor_user_id")
  type            String
  category        String
  title           String
  body            String?
  severity        String                 @default("info")
  entityType      String?                @map("entity_type")
  entityId        String?                @map("entity_id")
  actionUrl       String?                @map("action_url")
  destinationKey  String                 @default("cases") @map("destination_key")
  metadata        Json                   @default("{}")
  dedupeKey       String                 @map("dedupe_key")
  attentionLevel  String                 @default("update") @map("attention_level")
  occurrenceCount Int                    @default(1) @map("occurrence_count")
  lastOccurredAt  DateTime               @default(now()) @map("last_occurred_at")
  readAt          DateTime?              @map("read_at")
  dismissedAt     DateTime?              @map("dismissed_at")
  resolvedAt      DateTime?              @map("resolved_at")
  expiresAt       DateTime?              @map("expires_at")
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")
  agency          Agency                 @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  recipient       User                   @relation("NotificationRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)
  actor           User?                  @relation("NotificationActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  deliveries      NotificationDelivery[]

  @@unique([agencyId, recipientUserId, dedupeKey])
  @@index([recipientUserId, dismissedAt, createdAt])
  @@index([recipientUserId, readAt, createdAt])
  @@index([recipientUserId, attentionLevel, resolvedAt, lastOccurredAt])
  @@index([recipientUserId, destinationKey, resolvedAt, readAt])
  @@index([expiresAt])
  @@index([agencyId, category, createdAt])
  @@map("notifications")
}

model NotificationPreference {
  id              String    @id @default(uuid())
  agencyId        String    @map("agency_id")
  userId          String    @map("user_id")
  category        String    @default("all")
  inAppEnabled    Boolean   @default(true) @map("in_app_enabled")
  emailEnabled    Boolean   @default(false) @map("email_enabled")
  smsEnabled      Boolean   @default(false) @map("sms_enabled")
  dueSoonMinutes  Int       @default(1440) @map("due_soon_minutes")
  quietHoursStart String?   @map("quiet_hours_start")
  quietHoursEnd   String?   @map("quiet_hours_end")
  timezone        String    @default("America/Toronto")
  deliveryMode    String    @default("immediate") @map("delivery_mode")
  digestHour      Int       @default(9) @map("digest_hour")
  lastDigestAt    DateTime? @map("last_digest_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  agency          Agency    @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@index([agencyId])
  @@map("notification_preferences")
}

// Case Easy import (staging layer) — see docs/production/case-easy-import-prompt.md.
// Purely additive: no existing Client/Case/CaseAssessment table is touched.
// Raw exported data lives here permanently (even after conversion, as the
// audit trail/backup) and is only ever turned into real Client/Case rows
// via an explicit, one-at-a-time conversion action — never a live sync.
enum CaseEasyRecordType {
  client
  prospect
}

enum CaseEasyContactImportStatus {
  imported
  reviewed
  converted
}

enum CaseEasyCaseImportStatus {
  imported
  reviewed
  converted
  needs_review
}

enum CaseEasyCaseReviewReason {
  unlinked_contact
  assignee_mismatch
  conflicting_toggle
}

enum CaseEasyReportType {
  payment_requests
  invoices
  payments
  receipts
  account_receivables
  retainer_balances
  client_listing
  trust_balances
  reminders
  time_entries
  trust_account_entries
  activity_tracker
  case_information
  employers_applications
  e_signatures
}

enum CaseEasyReportLinkStatus {
  linked
  unlinked
  ambiguous
}

enum CaseEasyReportImportStatus {
  imported
  reviewed
}

model CaseEasyImportContact {
  id                 String                      @id @default(uuid())
  agencyId           String                      @map("agency_id")
  uci                String?
  firstName          String?                     @map("first_name")
  lastName           String?                     @map("last_name")
  maritalStatus      String?                     @map("marital_status")
  dateOfBirth        DateTime?                   @map("date_of_birth")
  email              String?
  phone              String?
  countryOfResidence String?                     @map("country_of_residence")
  nocTeer            String?                     @map("noc_teer")
  referralSource     String?                     @map("referral_source")
  sourceCreated      DateTime?                   @map("source_created")
  clientIdentifier   String?                     @map("client_identifier")
  importedAt         DateTime                    @default(now()) @map("imported_at")
  importBatchId      String                      @map("import_batch_id")
  // Nullable, not just client/prospect: a contact whose linked cases have
  // conflicting Prospect/Client toggles has no single correct value — the
  // import prompt is explicit that this must be flagged for manual review,
  // not guessed. Null means "undetermined, needs review" until resolved.
  recordType         CaseEasyRecordType?         @map("record_type")
  importStatus       CaseEasyContactImportStatus @default(imported) @map("import_status")
  convertedClientId  String?                     @map("converted_client_id")
  createdAt          DateTime                    @default(now()) @map("created_at")
  updatedAt          DateTime                    @updatedAt @map("updated_at")
  agency             Agency                      @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  convertedClient    Client?                     @relation(fields: [convertedClientId], references: [id], onDelete: SetNull)
  linkedCases        CaseEasyImportCase[]
  reportRows         CaseEasyImportReportRow[]

  @@index([agencyId])
  @@index([agencyId, importBatchId])
  @@index([agencyId, email])
  @@index([agencyId, clientIdentifier])
  @@map("case_easy_import_contacts")
}

model CaseEasyImportCase {
  id                         String                     @id @default(uuid())
  agencyId                   String                     @map("agency_id")
  applicantIdKey             String?                    @map("applicant_id_key")
  caseNumber                 String?                    @map("case_number")
  companyName                String?                    @map("company_name")
  status                     String?
  caseType                   String?                    @map("case_type")
  nocTeer                    String?                    @map("noc_teer")
  jobTitle                   String?                    @map("job_title")
  assignees                  String?
  referralSource             String?                    @map("referral_source")
  category                   String?
  tags                       String?
  officeLocation             String?                    @map("office_location")
  opened                     DateTime?
  approved                   DateTime?
  submitted                  DateTime?
  refused                    DateTime?
  sourceCreated              DateTime?                  @map("source_created")
  otherContacts              String?                    @map("other_contacts")
  primaryAddress             String?                    @map("primary_address")
  phone                      String?
  otherEmails                String?                    @map("other_emails")
  email                      String?
  firstName                  String?                    @map("first_name")
  lastName                   String?                    @map("last_name")
  modified                   DateTime?
  lastNote                   String?                    @map("last_note")
  lastNoteDate               DateTime?                  @map("last_note_date")
  clientIdentifier           String?                    @map("client_identifier")
  foreignNationalArrivalDate DateTime?                  @map("foreign_national_arrival_date")
  resubmissionDate           DateTime?                  @map("resubmission_date")
  extensionSubmissionDate    DateTime?                  @map("extension_submission_date")
  instructionsSentDate       DateTime?                  @map("instructions_sent_date")
  returnedDate               DateTime?                  @map("returned_date")
  deferralReceivedDate       DateTime?                  @map("deferral_received_date")
  // Raw Case Easy Prospect/Client toggle value, kept even though it's
  // redundant with the linked contact's derived recordType — source data
  // stays fully preserved regardless of what we infer from it.
  prospectOrClient           String?                    @map("prospect_or_client")
  importedAt                 DateTime                   @default(now()) @map("imported_at")
  importBatchId              String                     @map("import_batch_id")
  linkedContactId            String?                    @map("linked_contact_id")
  importStatus               CaseEasyCaseImportStatus   @default(imported) @map("import_status")
  needsReviewReason          CaseEasyCaseReviewReason?  @map("needs_review_reason")
  needsReviewReasons         CaseEasyCaseReviewReason[] @default([]) @map("needs_review_reasons")
  resolvedAssigneeUserId     String?                    @map("resolved_assignee_user_id")
  convertedCaseId            String?                    @map("converted_case_id")
  createdAt                  DateTime                   @default(now()) @map("created_at")
  updatedAt                  DateTime                   @updatedAt @map("updated_at")
  agency                     Agency                     @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  linkedContact              CaseEasyImportContact?     @relation(fields: [linkedContactId], references: [id], onDelete: SetNull)
  resolvedAssignee           User?                      @relation("CaseEasyImportCaseResolvedAssignee", fields: [resolvedAssigneeUserId], references: [id], onDelete: SetNull)
  convertedCase              Case?                      @relation(fields: [convertedCaseId], references: [id], onDelete: SetNull)
  reportRows                 CaseEasyImportReportRow[]

  @@index([agencyId])
  @@index([agencyId, importBatchId])
  @@index([agencyId, caseNumber])
  @@index([agencyId, clientIdentifier])
  @@index([linkedContactId])
  @@map("case_easy_import_cases")
}

// All supported Case Easy report exports share one durable staging shape.
// Identity columns are normalized for linking and filtering, while rawData
// retains every selected source column exactly as exported. A report-type
// discriminator avoids 15 near-identical tables and lets CaseDesk consume
// all report categories through one tenant-scoped API.
model CaseEasyImportReportRow {
  id                 String                     @id @default(uuid())
  agencyId           String                     @map("agency_id")
  reportType         CaseEasyReportType         @map("report_type")
  sourceRowKey       String                     @map("source_row_key")
  caseNumber         String?                    @map("case_number")
  uci                String?
  clientIdentifier   String?                    @map("client_identifier")
  fullName           String?                    @map("full_name")
  email              String?
  caseType           String?                    @map("case_type")
  caseStatus         String?                    @map("case_status")
  firstName          String?                    @map("first_name")
  lastName           String?                    @map("last_name")
  companyName        String?                    @map("company_name")
  rawData            Json                       @map("raw_data")
  importedAt         DateTime                   @default(now()) @map("imported_at")
  importBatchId      String                     @map("import_batch_id")
  importStatus       CaseEasyReportImportStatus @default(imported) @map("import_status")
  linkStatus         CaseEasyReportLinkStatus   @default(unlinked) @map("link_status")
  linkReason         String?                    @map("link_reason")
  linkedContactId    String?                    @map("linked_contact_id")
  linkedImportCaseId String?                    @map("linked_import_case_id")
  linkedClientId     String?                    @map("linked_client_id")
  linkedCaseId       String?                    @map("linked_case_id")
  createdAt          DateTime                   @default(now()) @map("created_at")
  updatedAt          DateTime                   @updatedAt @map("updated_at")
  agency             Agency                     @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  linkedContact      CaseEasyImportContact?     @relation(fields: [linkedContactId], references: [id], onDelete: SetNull)
  linkedImportCase   CaseEasyImportCase?        @relation(fields: [linkedImportCaseId], references: [id], onDelete: SetNull)
  linkedClient       Client?                    @relation(fields: [linkedClientId], references: [id], onDelete: SetNull)
  linkedCase         Case?                      @relation(fields: [linkedCaseId], references: [id], onDelete: SetNull)

  @@unique([agencyId, reportType, sourceRowKey])
  @@index([agencyId, reportType, importedAt])
  @@index([agencyId, clientIdentifier])
  @@index([agencyId, caseNumber])
  @@index([linkedContactId])
  @@index([linkedImportCaseId])
  @@index([linkedClientId])
  @@index([linkedCaseId])
  @@map("case_easy_import_report_rows")
}

model NotificationDelivery {
  id              String       @id @default(uuid())
  agencyId        String       @map("agency_id")
  notificationId  String       @map("notification_id")
  recipientUserId String       @map("recipient_user_id")
  channel         String
  status          String       @default("pending")
  attempts        Int          @default(0)
  maxAttempts     Int          @default(5) @map("max_attempts")
  availableAt     DateTime     @default(now()) @map("available_at")
  sentAt          DateTime?    @map("sent_at")
  deliveredAt     DateTime?    @map("delivered_at")
  failedAt        DateTime?    @map("failed_at")
  providerId      String?      @map("provider_id")
  lastError       String?      @map("last_error")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  agency          Agency       @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  notification    Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  recipient       User         @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@unique([notificationId, channel])
  @@index([status, availableAt])
  @@index([recipientUserId, createdAt])
  @@map("notification_deliveries")
}
