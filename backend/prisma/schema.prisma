model AgencyMember {
  id                 String   @id @default(uuid())
  agencyId           String   @map("agency_id")
  userId             String   @map("user_id")
  role               UserRole
  isActive           Boolean  @default(true) @map("is_active")
  permissions        Json     @default("{}")
  mustChangePassword Boolean  @default(false) @map("must_change_password")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  agency             Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([agencyId, userId])
  @@index([userId, isActive])
  @@index([agencyId, role, isActive])
  @@map("agency_members")
}

model OnboardingRequest {
  id              String                  @id @default(uuid())
  email           String                  @unique
  fullName        String                  @map("full_name")
  agencyName      String                  @map("agency_name")
  phone           String?
  country         String?
  status          OnboardingRequestStatus @default(pending)
  agencyId        String?                 @map("agency_id")
  userId          String?                 @map("user_id")
  authUserId      String?                 @unique @map("auth_user_id") @db.Uuid
  termsAcceptedAt DateTime                @map("terms_accepted_at")
  invitedAt       DateTime?               @map("invited_at")
  completedAt     DateTime?               @map("completed_at")
  expiresAt       DateTime?               @map("expires_at")
  failureCode     String?                 @map("failure_code")
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")
  agency          Agency?                 @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  user            User?                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, expiresAt])
  @@index([agencyId])
  @@map("onboarding_requests")
}

model ConsultantProfile {
  id                 String   @id @default(uuid())
  agencyId           String   @map("agency_id")
  userId             String   @map("user_id")
  employeeId         String?  @map("employee_id")
  specializations    String[] @default([])
  masteryLevel       String?  @map("mastery_level")
  maximumActiveCases Int      @default(20) @map("maximum_active_cases")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  agency             Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([agencyId, userId])
  @@unique([agencyId, employeeId])
  @@index([agencyId])
  @@map("consultant_profiles")
}

model ClientUser {
  id           String   @id @default(uuid())
  agencyId     String   @map("agency_id")
  clientId     String   @map("client_id")
  userId       String   @map("user_id")
  relationship String?
  isPrimary    Boolean  @default(true) @map("is_primary")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  agency       Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([agencyId, clientId, userId])
  @@index([agencyId, userId])
  @@index([clientId])
  @@map("client_users")
}

model CaseAssignment {
  id               String           @id @default(uuid())
  agencyId         String           @map("agency_id")
  caseId           String           @map("case_id")
  consultantUserId String           @map("consultant_user_id")
  assignmentType   AssignmentType   @default(primary) @map("assignment_type")
  status           AssignmentStatus @default(active)
  assignedById     String?          @map("assigned_by")
  assignedAt       DateTime         @default(now()) @map("assigned_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  agency           Agency           @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  case             Case             @relation(fields: [caseId], references: [id], onDelete: Cascade)
  consultant       User             @relation("AssignedConsultant", fields: [consultantUserId], references: [id], onDelete: Cascade)
  assignedBy       User?            @relation("CaseAssignmentActor", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([agencyId, caseId, consultantUserId, assignmentType])
  @@index([agencyId, consultantUserId, status])
  @@index([caseId, status])
  @@map("case_assignments")
}

enum CaseCollaborationRequestStatus {
  Pending
  Approved
  Declined
  Withdrawn
}

enum PortalPolicyScope {
  AGENCY
  CASE
  CLIENT_USER
}

enum PortalPolicyStatus {
  ACTIVE
  RESTRICTED
  SUSPENDED
}

model PortalAccessPolicy {
  id          String             @id @default(uuid())
  agencyId    String             @map("agency_id")
  scope       PortalPolicyScope
  scopeId     String             @map("scope_id")
  preset      String             @default("STANDARD")
  status      PortalPolicyStatus @default(ACTIVE)
  permissions Json               @default("{}")
  vetoes      Json               @default("{}")
  validFrom   DateTime?          @map("valid_from")
  validUntil  DateTime?          @map("valid_until")
  updatedById String?            @map("updated_by_id")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  agency      Agency             @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@unique([agencyId, scope, scopeId])
  @@index([agencyId, scope])
  @@index([agencyId, validUntil])
  @@map("portal_access_policies")
}

// A consultant's self-service ask to join a case they don't currently own
// or collaborate on (Phase 4 of the Team Workload refinement plan). Admin
// approval creates the actual CaseAssignment row via the existing
// /cases/:id/permissions contract — this table only tracks the ask itself.
model CaseCollaborationRequest {
  id            String                         @id @default(uuid())
  agencyId      String                         @map("agency_id")
  caseId        String                         @map("case_id")
  requestedById String                         @map("requested_by_id")
  requestedRole AssignmentType                 @default(supporting) @map("requested_role")
  note          String?
  status        CaseCollaborationRequestStatus @default(Pending)
  reviewedById  String?                        @map("reviewed_by_id")
  reviewedAt    DateTime?                      @map("reviewed_at")
  reviewNote    String?                        @map("review_note")
  createdAt     DateTime                       @default(now()) @map("created_at")
  updatedAt     DateTime                       @updatedAt @map("updated_at")
  agency        Agency                         @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  case          Case                           @relation(fields: [caseId], references: [id], onDelete: Cascade)
  requestedBy   User                           @relation("CaseCollaborationRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  reviewedBy    User?                          @relation("CaseCollaborationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([agencyId, status])
  @@index([caseId, status])
  @@index([requestedById, status])
  @@map("case_collaboration_requests")
}

// Who holds which incentive-attribution role on a case (e.g. this case's
// RCIC, this case's Case Worker). Deliberately separate from
// CaseAssignment, which governs case access/permissions — incentive
// attribution and case access are different concerns that can evolve
// independently (see AgencyCaseRole).
model CaseRoleAssignment {
  id           String           @id @default(uuid())
  agencyId     String           @map("agency_id")
  caseId       String           @map("case_id")
  caseRoleId   String           @map("case_role_id")
  userId       String           @map("user_id")
  assignedById String?          @map("assigned_by")
  status       AssignmentStatus @default(active)
  assignedAt   DateTime         @default(now()) @map("assigned_at")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  agency       Agency           @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  case         Case             @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseRole     AgencyCaseRole   @relation(fields: [caseRoleId], references: [id], onDelete: Cascade)
  user         User             @relation("CaseRoleAssignmentUser", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy   User?            @relation("CaseRoleAssignmentActor", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([agencyId, caseId, caseRoleId, userId])
  @@index([agencyId, caseId, status])
  @@index([agencyId, userId, status])
  @@map("case_role_assignments")
}

// Global incentive attribution configured once on Team Members. These
// assignments determine who may receive CASE_ROLE shares when they own or
// collaborate on a case; they do not grant access or alter a login role.
model TeamIncentiveRoleAssignment {
  id         String         @id @default(uuid())
  agencyId   String         @map("agency_id")
  caseRoleId String         @map("case_role_id")
  userId     String         @map("user_id")
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")
  agency     Agency         @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  caseRole   AgencyCaseRole @relation(fields: [caseRoleId], references: [id], onDelete: Cascade)
  user       User           @relation("TeamIncentiveRoleUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([agencyId, caseRoleId, userId])
  @@index([agencyId, caseRoleId])
  @@index([agencyId, userId])
  @@map("team_incentive_role_assignments")
}

model Client {
  id                         String                       @id @default(uuid())
  agencyId                   String                       @map("agency_id")
  clientNumber               String                       @map("client_number")
  fullName                   String                       @map("full_name")
  // Structured name split, mirroring ImmigrationProfile — most IRCC forms
  // (IMM 5476 included) want family/given name separately, not one string.
  // Nullable for legacy/guest-created records; fullName remains the display
  // value everywhere else. Staff confirm the structured split when editing.
  familyName                 String?                      @map("family_name")
  givenNames                 String?                      @map("given_names")
  // Unique Client Identifier — IRCC's own ID, requested on nearly every
  // form once a client has dealt with them before.
  uci                        String?
  phone                      String?
  phoneNormalized            String?                      @map("phone_normalized")
  email                      String?
  emailNormalized            String?                      @map("email_normalized")
  dateOfBirth                DateTime?                    @map("date_of_birth")
  maritalStatus              String?                      @map("marital_status")
  address                    String?
  preferredLanguage          String?                      @map("preferred_language")
  identificationType         String?                      @map("identification_type")
  identificationNumber       String?                      @map("identification_number")
  identificationCountry      String?                      @map("identification_country")
  identificationExpiryDate   DateTime?                    @map("identification_expiry_date")
  status                     ClientStatus
  archivedAt                 DateTime?                    @map("archived_at")
  qbCustomerId               String?                      @map("qb_customer_id")
  qbSyncStatus               String?                      @map("qb_sync_status")
  qbSyncError                String?                      @map("qb_sync_error")
  qbSyncedAt                 DateTime?                    @map("qb_synced_at")
  assignedUserId             String?                      @map("assigned_user_id")
  creationIdempotencyKey     String?                      @map("creation_idempotency_key")
  createdAt                  DateTime                     @default(now()) @map("created_at")
  updatedAt                  DateTime                     @updatedAt @map("updated_at")
  agency                     Agency                       @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  assignedUser               User?                        @relation("AssignedClientUser", fields: [assignedUserId], references: [id], onDelete: SetNull)
  cases                      Case[]
  clientDocuments            ClientDocument[]
  writtenDocuments           WrittenDocument[]
  notes                      Note[]
  followUps                  FollowUp[]
  payments                   Payment[]
  activityLogs               ActivityLog[]
  caseAssessments            CaseAssessment[]
  caseForms                  CaseForm[]
  appointments               Appointment[]
  bookingPaymentHolds        BookingPaymentHold[]
  communicationConversations CommunicationConversation[]
  communicationMessages      CommunicationMessage[]
  communicationConsents      CommunicationConsent[]
  communicationPreference    CommunicationPreference?
  communicationAccesses      ClientCommunicationAccess[]
  portalUsers                ClientUser[]
  accountStatements          AccountStatementGeneration[]
  convertedFromLead          Lead?                        @relation("LeadConvertedClient")
  earlyForLead               Lead?                        @relation("LeadEarlyClient")
  leadConversions            LeadConversion[]
  questionnaireAssignments   QuestionnaireAssignment[]
