  startsAt               DateTime                 @map("starts_at")
  endsAt                 DateTime                 @map("ends_at")
  description            String?
  purpose                String?
  internalNotes          String?                  @map("internal_notes")
  guestName              String?                  @map("guest_name")
  guestEmail             String?                  @map("guest_email")
  guestEmailNormalized   String?                  @map("guest_email_normalized")
  guestPhone             String?                  @map("guest_phone")
  meetingMode            String                   @default("InPerson") @map("meeting_mode")
  meetingUrl             String?                  @map("meeting_url")
  meetingPhoneNumber     String?                  @map("meeting_phone_number")
  meetingProvider        String?                  @map("meeting_provider")
  meetingProviderId      String?                  @map("meeting_provider_id")
  meetingProviderHostId  String?                  @map("meeting_provider_host_id")
  meetingSyncStatus      String                   @default("NotRequired") @map("meeting_sync_status")
  meetingSyncError       String?                  @map("meeting_sync_error")
  manageToken            String?                  @unique @default(uuid()) @map("manage_token")
  reminderSentAt         DateTime?                @map("reminder_sent_at")
  reminderDueAt          DateTime?                @map("reminder_due_at")
  reminderQueuedAt       DateTime?                @map("reminder_queued_at")
