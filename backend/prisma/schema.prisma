  accountSid            String?   @map("account_sid")
  authTokenEncrypted    String?   @map("auth_token_encrypted")
  fromNumber            String?   @map("from_number")
  messagingServiceSid   String?   @map("messaging_service_sid")
  // Twilio Voice — browser softphone. The API Key (SID + Secret) signs the
  // Access Tokens the Voice SDK needs; the secret is encrypted like the
  // Auth Token. voiceNumber is the number calls are placed FROM (falls back
  // to fromNumber) and twimlAppSid is the TwiML Application that carries
  // outbound calls to CaseDesk's TwiML handler (provisioned automatically).
  apiKeySid             String?   @map("api_key_sid")
  apiKeySecretEncrypted String?   @map("api_key_secret_encrypted")
  callsEnabled          Boolean   @default(false) @map("calls_enabled")
  voiceNumber           String?   @map("voice_number")
  twimlAppSid           String?   @map("twiml_app_sid")
  lastCallTestedAt      DateTime? @map("last_call_tested_at")
  lastCallTestStatus    String?   @map("last_call_test_status")
  lastCallTestMessage   String?   @map("last_call_test_message")
  enabled               Boolean   @default(true)
  smsEnabled            Boolean   @default(true) @map("sms_enabled")
  lastVerifiedAt        DateTime? @map("last_verified_at")
  lastVerifiedStatus    String?   @map("last_verified_status")
  lastVerifiedMessage   String?   @map("last_verified_message")
  lastSmsTestedAt       DateTime? @map("last_sms_tested_at")
  lastSmsTestStatus     String?   @map("last_sms_test_status")
  lastSmsTestMessage    String?   @map("last_sms_test_message")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  agency                Agency    @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@index([agencyId])
  @@map("agency_twilio_settings")
}

model CallSession {
  id                     String          @id @default(uuid())
  agencyId               String          @map("agency_id")
