// Admin-managed vocabulary of case-level incentive roles (e.g. "RCIC",
// "Case Worker", "Reviewer") — deliberately decoupled from the
// CaseAssignment/AssignmentType enum, which is load-bearing for case access
// permissions today. Renaming or adding a role here is a settings change,
// not a migration.
model AgencyCaseRole {
  id              String                        @id @default(uuid())
  agencyId        String                        @map("agency_id")
  code            String
  name            String
  description     String?
  isActive        Boolean                       @default(true) @map("is_active")
  isSystem        Boolean                       @default(false) @map("is_system")
  sortOrder       Int                           @default(0) @map("sort_order")
  createdAt       DateTime                      @default(now()) @map("created_at")
  updatedAt       DateTime                      @updatedAt @map("updated_at")
  agency          Agency                        @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  assignments     CaseRoleAssignment[]
  teamAssignments TeamIncentiveRoleAssignment[]
  roleShares      IncentivePlanRoleShare[]
  ledgerEntries   IncentiveLedgerEntry[]

  @@unique([agencyId, code])
  @@index([agencyId, isActive, sortOrder])
  @@map("agency_case_roles")
}

// A configurable incentive-payout template. `formulaType` picks the shape
// (flat/percent/tiered) and its own numbers (flatAmount/percentRate/tiers)
// are admin-editable at any time — formulas are expected to keep changing,
// so nothing here should require a code deploy to adjust a rate or target.
// Exactly one plan may be `isActive` per (agencyId, caseType) scope; that
// invariant is enforced by a hand-written partial unique index in this
// model's migration (Prisma's @@unique can't express "only when active"),
// and flipped atomically by the dedicated activate action rather than a
// plain isActive toggle.
model IncentivePlan {
  id                            String                           @id @default(uuid())
  agencyId                      String                           @map("agency_id")
  name                          String
  caseType                      String?                          @map("case_type")
  formulaType                   String                           @map("formula_type")
  flatAmount                    Decimal?                         @map("flat_amount") @db.Decimal(10, 2)
  percentRate                   Decimal?                         @map("percent_rate") @db.Decimal(5, 2)
  isActive                      Boolean                          @default(false) @map("is_active")
  isSystem                      Boolean                          @default(false) @map("is_system")
  version                       Int                              @default(1)
  createdById                   String?                          @map("created_by")
  activatedAt                   DateTime?                        @map("activated_at")
  deactivatedAt                 DateTime?                        @map("deactivated_at")
  createdAt                     DateTime                         @default(now()) @map("created_at")
  updatedAt                     DateTime                         @updatedAt @map("updated_at")
  agency                        Agency                           @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  createdBy                     User?                            @relation("IncentivePlanCreatedByUser", fields: [createdById], references: [id], onDelete: SetNull)
  tiers                         IncentivePlanTier[]
  roleShares                    IncentivePlanRoleShare[]
  timelineLegs                  IncentivePlanTimelineLeg[]
  ledgerEntries                 IncentiveLedgerEntry[]
  timelineLegEvaluations        IncentiveTimelineLegEvaluation[]
  caseInvoiceIncentiveSnapshots CaseInvoiceIncentiveSnapshot[]

  @@index([agencyId, caseType, isActive])
  @@map("incentive_plans")
}

// Only populated when the owning plan's formulaType is
// TIERED_PERCENT_OF_REVENUE — the rate applied depends on the case's
// cumulative collected revenue after the triggering payment.
model IncentivePlanTier {
  id                  String        @id @default(uuid())
  planId              String        @map("plan_id")
  minCumulativeAmount Decimal       @map("min_cumulative_amount") @db.Decimal(10, 2)
  rate                Decimal       @map("rate") @db.Decimal(5, 2)
  sortOrder           Int           @default(0) @map("sort_order")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")
  plan                IncentivePlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, minCumulativeAmount])
  @@map("incentive_plan_tiers")
}

// How a plan's payout pool splits across the people who touched a case.
// attributionKind CASE_ROLE requires caseRoleId (an AgencyCaseRole);
// LEAD_OWNER/LEAD_CONVERTER attribute to the case's originating Lead
// instead and never set caseRoleId. Shares on one plan must sum to exactly
// 100.00 — enforced in incentivePlanService, not the database, the same way
// AgencyFeeCategory's other invariants are app-level.
//
// caseRoleId is onDelete: Restrict so a role actively used in a plan's
// split can't be silently deleted out from under it (caseRoleService
// checks for this and returns a friendly error before ever reaching the
// DB constraint). Known tradeoff: this makes a blind cascading delete of
// an entire Agency fail once any role share exists, because Postgres
// resolves each FK's action independently rather than waiting for the
// sibling incentive_plans -> incentive_plan_role_shares cascade to run
// first. The one place this repo deletes an Agency today
// (onboardingController's invite-failure rollback) only ever runs against
// a just-created agency that can't have incentive data yet, so this is
// currently unreachable — but any future full-tenant-deletion flow must
// delete incentive_plan_role_shares (or the owning incentive_plans) before
// deleting the agency's case roles, not rely on cascade alone.
model IncentivePlanRoleShare {
  id              String          @id @default(uuid())
  planId          String          @map("plan_id")
  attributionKind String          @map("attribution_kind")
  caseRoleId      String?         @map("case_role_id")
  sharePercent    Decimal         @map("share_percent") @db.Decimal(5, 2)
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  plan            IncentivePlan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  caseRole        AgencyCaseRole? @relation(fields: [caseRoleId], references: [id], onDelete: Restrict)

  @@map("incentive_plan_role_shares")
}

// A milestone-to-milestone "leg" of a plan's timeline (e.g. Lead created ->
// Lead reaches Qualified). Pays its own flat bonus, split by the plan's
// existing roleShares, scaled by how fast the leg was actually completed
// (see tiers below) — independent of the plan's payment-triggered formula
// above. Deleted and recreated whole on every plan save, same lifecycle as
// tiers/roleShares — see IncentiveTimelineLegEvaluation for why evaluation
// history intentionally does NOT hard-FK back to this row.
model IncentivePlanTimelineLeg {
  id                  String                         @id @default(uuid())
  planId              String                         @map("plan_id")
  name                String
  sortOrder           Int                            @default(0) @map("sort_order")
  fromCheckpointType  String                         @map("from_checkpoint_type")
  fromCheckpointValue String?                        @map("from_checkpoint_value")
  toCheckpointType    String                         @map("to_checkpoint_type")
  toCheckpointValue   String?                        @map("to_checkpoint_value")
  baseBonusAmount     Decimal                        @map("base_bonus_amount") @db.Decimal(10, 2)
  createdAt           DateTime                       @default(now()) @map("created_at")
  updatedAt           DateTime                       @updatedAt @map("updated_at")
  plan                IncentivePlan                  @relation(fields: [planId], references: [id], onDelete: Cascade)
  tiers               IncentivePlanTimelineLegTier[]

  @@index([planId])
  @@map("incentive_plan_timeline_legs")
}

// The days-to-multiplier ladder for one leg — mirrors IncentivePlanTier's
// shape, just inverted: the SMALLEST thresholdDays that is >= the actual
// elapsed time wins (the loosest tier the case still qualified for), not the
// largest threshold cleared. Missing every tier pays nothing for this leg.
model IncentivePlanTimelineLegTier {
  id                String                   @id @default(uuid())
  legId             String                   @map("leg_id")
  thresholdDays     Decimal                  @map("threshold_days") @db.Decimal(6, 2)
  multiplierPercent Decimal                  @map("multiplier_percent") @db.Decimal(5, 2)
  sortOrder         Int                      @default(0) @map("sort_order")
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @updatedAt @map("updated_at")
  leg               IncentivePlanTimelineLeg @relation(fields: [legId], references: [id], onDelete: Cascade)

  @@unique([legId, thresholdDays])
  @@map("incentive_plan_timeline_leg_tiers")
}

