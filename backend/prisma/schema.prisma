  @@unique([agencyId, providerCallId])
  @@index([agencyId, resolution, lastEventAt])
  @@index([agencyId, status, lastEventAt])
  @@index([agencyId, remoteNumberNormalized])
  @@index([followUpId])
  @@index([leadId, startedAt])
  @@index([clientId, startedAt])
  @@index([appointmentId])
  @@index([agencyId, handledByUserId, startedAt])
  @@map("ooma_call_sessions")
}

