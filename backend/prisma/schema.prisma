// Durable staff-entered payment record and approval trail. Frontdesk entries
// remain Pending until an administrator decides them. Approved cash stays in
// CaseDesk; approved non-cash entries retain their QuickBooks payment result.
model PaymentApproval {
  id                   String                     @id @default(uuid())
  agencyId             String                     @map("agency_id")
  clientId             String?                    @map("client_id")
  caseId               String?                    @map("case_id")
  appointmentId        String?                    @map("appointment_id")
  caseInvoiceId        String?                    @map("case_invoice_id")
  paymentId            String?                    @map("payment_id")
  customLedgerId       String?                    @map("custom_ledger_id")
  entryType            String                     @map("entry_type")
  method               String
  amount               Decimal                    @db.Decimal(10, 2)
  chargeAmount         Decimal?                   @map("charge_amount") @db.Decimal(10, 2)
  paymentType          String?                    @map("payment_type")
  description          String?
  transactionReference String?                    @map("transaction_reference")
  paymentDate          DateTime                   @map("payment_date") @db.Date
  note                 String?
  status               String                     @default("Pending")
  sourceRole           String                     @map("source_role")
  idempotencyKey       String                     @map("idempotency_key")
  submittedById        String                     @map("submitted_by_id")
  reviewedById         String?                    @map("reviewed_by_id")
  reviewedAt           DateTime?                  @map("reviewed_at")
  rejectionReason      String?                    @map("rejection_reason")
  qbPaymentId          String?                    @map("qb_payment_id")
  processingError      String?                    @map("processing_error")
  result               Json?
  createdAt            DateTime                   @default(now()) @map("created_at")
  updatedAt            DateTime                   @updatedAt @map("updated_at")
  agency               Agency                     @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  client               Client?                    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  case                 Case?                      @relation(fields: [caseId], references: [id], onDelete: SetNull)
  appointment          Appointment?               @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  caseInvoice          CaseInvoice?               @relation(fields: [caseInvoiceId], references: [id], onDelete: SetNull)
  payment              Payment?                   @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  customLedger         AgencyCustomPaymentLedger? @relation(fields: [customLedgerId], references: [id], onDelete: SetNull)
  cashTransaction      CashTransaction?
  submittedBy          User                       @relation("SubmittedPaymentApprovalUser", fields: [submittedById], references: [id], onDelete: Restrict)
  reviewedBy           User?                      @relation("ReviewedPaymentApprovalUser", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([agencyId, idempotencyKey])
  @@index([agencyId, status, createdAt])
  @@index([clientId, createdAt])
  @@index([caseId, createdAt])
  @@index([appointmentId, createdAt])
  @@index([caseInvoiceId, createdAt])
  @@index([agencyId, customLedgerId, paymentDate])
  @@map("payment_approvals")
}

