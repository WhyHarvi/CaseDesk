model Agency {
  id                              String                             @id @default(uuid())
  name                            String
  slug                            String?                            @unique
  status                          AccountStatus                      @default(active)
  onboardingStatus                AgencyOnboardingStatus             @default(pending_setup) @map("onboarding_status")
  accessStatus                    AgencyAccessStatus                 @default(active) @map("access_status")
  phone                           String?
  email                           String?
  faxNumber                       String?                            @map("fax_number")
  address                         String?
  // Apt/Unit, kept separate from the street line — government forms like
  // IMM 5476 that split "Apt/Unit" from "Street no./Street name" read this
  // field first; the rest of the mailing address maps to address/city/
  // province/postalCode as-is. This is the single source for the
  // representative's mailing address across every case — edit it once in
  // Workspace Profile settings, not per case.
  addressUnit                     String?                            @map("address_unit")
  city                            String?
  province                        String?
  country                         String?
  postalCode                      String?                            @map("postal_code")
  legalName                       String?                            @map("legal_name")
  website                         String?
  logoUrl                         String?                            @map("logo_url")
  avatarStorageKey                String?                            @map("avatar_storage_key")
  avatarMimeType                  String?                            @map("avatar_mime_type")
  businessNumber                  String?                            @map("business_number")
  taxNumber                       String?                            @map("tax_number")
  // The agency's designated owner/signing authority — a fixed identity for
  // documents like the retainer agreement that should always show the
  // person who runs the agency, independent of which staff member happens
  // to be assigned to a given case. Deliberately plain text rather than a
  // User relation: a small agency's "owner" for signing purposes doesn't
  // have to be a CaseDesk staff account.
  ownerFullName                   String?                            @map("owner_full_name")
  ownerLicenseNumber              String?                            @map("owner_license_number")
  ownerPhone                      String?                            @map("owner_phone")
  ownerEmail                      String?                            @map("owner_email")
  // How large a drawn signature renders on government forms (IMM 5476 and
  // similar) — the fraction of the signature line/box it's stretched to
  // fill, on both axes. Null uses the built-in default (see
  // DEFAULT_SIGNATURE_FILL_FRACTION in imm5476SignatureFields.js).
  governmentFormSignatureScale    Float?                             @map("government_form_signature_scale")
  defaultCurrency                 String                             @default("CAD") @map("default_currency")
  locale                          String                             @default("en-CA")
  timezone                        String                             @default("America/Toronto")
  paymentInstructions             String?                            @map("payment_instructions")
  createdAt                       DateTime                           @default(now()) @map("created_at")
  updatedAt                       DateTime                           @updatedAt @map("updated_at")
  users                           User[]
  memberships                     AgencyMember[]
  consultantProfiles              ConsultantProfile[]
  clientUsers                     ClientUser[]
  caseAssignments                 CaseAssignment[]
  caseCollaborationRequests       CaseCollaborationRequest[]
  portalAccessPolicies            PortalAccessPolicy[]
  clients                         Client[]
  cases                           Case[]
  caseStageHistory                CaseStageHistory[]
  incentiveTimelineLegEvaluations IncentiveTimelineLegEvaluation[]
  documentTemplates               DocumentTemplate[]
  clientDocuments                 ClientDocument[]
  documentFolders                 DocumentFolder[]
  notes                           Note[]
  followUps                       FollowUp[]
  payments                        Payment[]
  activityLogs                    ActivityLog[]
  supportTickets                  SupportTicket[]
  portalActivity                  UserPortalActivity[]
  workflowTemplates               WorkflowTemplate[]
  workflowTemplateSteps           WorkflowTemplateStep[]
  caseWorkflowSteps               CaseWorkflowStep[]
  caseAssessments                 CaseAssessment[]
  sharedLibraryDocuments          SharedLibraryDocument[]
  writtenDocuments                WrittenDocument[]
  writtenDocumentVersions         WrittenDocumentVersion[]
  caseForms                       CaseForm[]
  caseFormVersions                CaseFormVersion[]
  caseFormReviewComments          CaseFormReviewComment[]
  agencyFormTemplates             AgencyFormTemplate[]
  agencyFormTemplateVersions      AgencyFormTemplateVersion[]
  formPermissions                 FormPermission[]
  caseFormAuditEvents             CaseFormAuditEvent[]
  formTemplateFieldSchemas        FormTemplateFieldSchema[]
