model User {
  id                                   String                          @id @default(uuid())
  agencyId                             String                          @map("agency_id")
  authUserId                           String?                         @unique @map("auth_user_id") @db.Uuid
  fullName                             String                          @map("full_name")
  // Optional, more reliable split than guessing from fullName — used
  // preferentially on government forms (IMM 5476 and similar) when set. See
  // Client.familyName/givenNames for the same pattern on the applicant side.
  firstName                            String?                         @map("first_name")
  lastName                             String?                         @map("last_name")
  email                                String                          @unique
  role                                 UserRole
  status                               AccountStatus                   @default(active)
  mustChangePassword                   Boolean                         @default(false) @map("must_change_password")
  phone                                String?
  jobTitle                             String?                         @map("job_title")
  avatarStorageKey                     String?                         @map("avatar_storage_key")
  avatarMimeType                       String?                         @map("avatar_mime_type")
  avatarPreset                         String?                         @map("avatar_preset")
  licenseNumber                        String?                         @map("license_number")
  // Representative-of-record fields for government forms (IMM 5476 and
  // similar). Deliberately on User, not ConsultantProfile — either an
  // admin or a consultant can be picked as the representative on a given
  // CaseForm, and admins don't always have a ConsultantProfile row.
  representativeType                   String?                         @map("representative_type")
  membershipBody                       String?                         @map("membership_body")
  membershipProvince                   String?                         @map("membership_province")
  // Explicit office phone/email to show on government forms for this
  // representative — separate from the account-level `phone`/`email` above,
  // which are for login/notifications and aren't necessarily the firm's
  // office line. Left blank, forms fall back to the shared agency phone/
  // email so every representative shows the same office contact by default;
  // set here to intentionally override it for one representative.
  formOfficePhone                      String?                         @map("form_office_phone")
  formOfficeEmail                      String?                         @map("form_office_email")
  // Drawn signature this licensed staff member has personally saved for
  // government forms. It belongs to the user, never to the agency.
  formSignatureImage                   String?                         @map("form_signature_image") @db.Text
  formSignatureStrokes                 Json?                           @map("form_signature_strokes")
  formSignatureUpdatedAt               DateTime?                       @map("form_signature_updated_at")
  createdAt                            DateTime                        @default(now()) @map("created_at")
  updatedAt                            DateTime                        @updatedAt @map("updated_at")
