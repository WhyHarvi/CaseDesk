model Case {
  id                           String                           @id @default(uuid())
  agencyId                     String                           @map("agency_id")
  clientId                     String                           @map("client_id")
  assignedUserId               String?                          @map("assigned_user_id")
  // Extra consultants beyond assignedUserId (the primary owner) — currently
  // only ever populated by Case Easy conversion, when the legacy case named
  // more than one assignee. Purely informational: nothing outside display
  // code reads this, unlike CaseAssignment (which incentives/notifications/
  // access control all read live) — deliberately kept inert.
  additionalAssignedUserIds    String[]                         @default([]) @map("additional_assigned_user_ids")
  caseType                     String                           @map("case_type")
  stage                        String
  status                       String
  priority                     String                           @default("Normal")
  nextAction                   String?                          @map("next_action")
  submittedAt                  DateTime?                        @map("submitted_at")
  decisionAt                   DateTime?                        @map("decision_at")
  // When this case actually opened, per its original source (currently only
  // populated by Case Easy conversion) — distinct from createdAt, which is
  // always the moment the real CaseDesk record was created, not when the
  // underlying case genuinely began.
  openedAt                     DateTime?                        @map("opened_at")
  studyIntakeMonth             DateTime?                        @map("study_intake_month") @db.Date
  creationIdempotencyKey       String?                          @map("creation_idempotency_key")
  // IRCC application number, once known — requested on nearly every
  // government form, not just IMM 5476.
  applicationNumber            String?                          @map("application_number")
  archivedAt                   DateTime?                        @map("archived_at")
  deletedAt                    DateTime?                        @map("deleted_at")
  createdAt                    DateTime                         @default(now()) @map("created_at")
  updatedAt                    DateTime                         @updatedAt @map("updated_at")
  agency                       Agency                           @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  client                       Client                           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  assignedUser                 User?                            @relation("AssignedCaseUser", fields: [assignedUserId], references: [id], onDelete: SetNull)
  clientDocuments              ClientDocument[]
  documentFolders              DocumentFolder[]
  writtenDocuments             WrittenDocument[]
  notes                        Note[]
  followUps                    FollowUp[]
  payments                     Payment[]
  activityLogs                 ActivityLog[]
  workflowSteps                CaseWorkflowStep[]
  assessment                   CaseAssessment?
  caseForms                    CaseForm[]
  appointments                 Appointment[]
  communicationConversations   CommunicationConversation[]
  communicationMessages        CommunicationMessage[]
  communicationAccesses        ClientCommunicationAccess[]
  immigrationProfileAccesses   ImmigrationProfileCaseAccess[]
  accountStatements            AccountStatementGeneration[]
  assignments                  CaseAssignment[]
  roleAssignments              CaseRoleAssignment[]
