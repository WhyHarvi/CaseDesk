model AutomatedReminderPolicy {
  id              String                      @id @default(uuid())
  agencyId        String                      @map("agency_id")
  kind            AutomatedReminderKind
  enabled         Boolean                     @default(false)
  cadenceDays     Int                         @default(7) @map("cadence_days")
  maxReminders    Int                         @default(3) @map("max_reminders")
  defaultDueDays  Int                         @default(30) @map("default_due_days")
  emailEnabled    Boolean                     @default(true) @map("email_enabled")
  smsEnabled      Boolean                     @default(false) @map("sms_enabled")
  subjectTemplate String                      @map("subject_template")
  messageTemplate String                      @map("message_template")
  smsTemplate     String                      @map("sms_template")
  createdAt       DateTime                    @default(now()) @map("created_at")
  updatedAt       DateTime                    @updatedAt @map("updated_at")
  agency          Agency                      @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  deliveries      AutomatedReminderDelivery[]

  @@unique([agencyId, kind])
  @@index([agencyId, enabled])
  @@map("automated_reminder_policies")
}

model AutomatedReminderDelivery {
  id             String                  @id @default(uuid())
  agencyId       String                  @map("agency_id")
  policyId       String                  @map("policy_id")
  targetId       String                  @map("target_id")
  clientId       String                  @map("client_id")
  sequence       Int
  status         String                  @default("processing")
  attempts       Int                     @default(0)
  effectiveDueAt DateTime                @map("effective_due_at")
  emailSentAt    DateTime?               @map("email_sent_at")
  smsSentAt      DateTime?               @map("sms_sent_at")
  portalSentAt   DateTime?               @map("portal_sent_at")
  sentAt         DateTime?               @map("sent_at")
  nextAttemptAt  DateTime?               @map("next_attempt_at")
  lastError      String?                 @map("last_error")
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")
  agency         Agency                  @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  policy         AutomatedReminderPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@unique([policyId, targetId, sequence])
  @@index([agencyId, status, nextAttemptAt])
  @@index([policyId, targetId, sentAt])
  @@map("automated_reminder_deliveries")
}

model ExpiringDocumentReminderPolicy {
  id              String                             @id @default(uuid())
  agencyId        String                             @map("agency_id")
  documentKey     String                             @map("document_key")
  enabled         Boolean                            @default(false)
  notifyClient    Boolean                            @default(true) @map("notify_client")
  leadDays        Int                                @default(183) @map("lead_days")
  cadenceDays     Int                                @default(30) @map("cadence_days")
  maxReminders    Int                                @default(1) @map("max_reminders")
  emailEnabled    Boolean                            @default(true) @map("email_enabled")
  smsEnabled      Boolean                            @default(false) @map("sms_enabled")
  subjectTemplate String                             @map("subject_template")
  messageTemplate String                             @map("message_template")
  smsTemplate     String                             @map("sms_template")
  createdAt       DateTime                           @default(now()) @map("created_at")
  updatedAt       DateTime                           @updatedAt @map("updated_at")
  agency          Agency                             @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  deliveries      ExpiringDocumentReminderDelivery[]

  @@unique([agencyId, documentKey])
  @@index([agencyId, enabled])
  @@map("expiring_document_reminder_policies")
}

model ExpiringDocumentReminderDelivery {
  id            String                         @id @default(uuid())
  agencyId      String                         @map("agency_id")
  policyId      String                         @map("policy_id")
  targetKey     String                         @map("target_key")
  clientId      String                         @map("client_id")
  caseId        String?                        @map("case_id")
  sequence      Int
  status        String                         @default("processing")
  attempts      Int                            @default(0)
  expiresAt     DateTime                       @map("expires_at")
  emailSentAt   DateTime?                      @map("email_sent_at")
  smsSentAt     DateTime?                      @map("sms_sent_at")
  portalSentAt  DateTime?                      @map("portal_sent_at")
  staffSentAt   DateTime?                      @map("staff_sent_at")
  sentAt        DateTime?                      @map("sent_at")
  nextAttemptAt DateTime?                      @map("next_attempt_at")
  lastError     String?                        @map("last_error")
  createdAt     DateTime                       @default(now()) @map("created_at")
  updatedAt     DateTime                       @updatedAt @map("updated_at")
  agency        Agency                         @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  policy        ExpiringDocumentReminderPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@unique([policyId, targetKey, sequence])
  @@index([agencyId, status, nextAttemptAt])
  @@index([policyId, targetKey, sentAt])
  @@map("expiring_document_reminder_deliveries")
}

model CaseInvoice {
  id                              String                        @id @default(uuid())
  agencyId                        String                        @map("agency_id")
  caseId                          String                        @map("case_id")
  clientId                        String                        @map("client_id")
  paymentType                     String                        @map("payment_type")
  description                     String
  // The CaseDesk invoice is the durable business document. QuickBooks fields
  // are optional because cash-only invoices never leave CaseDesk.
  invoiceNumber                   String                        @map("invoice_number")
  accountingProvider              String                        @default("QuickBooks") @map("accounting_provider")
  customLedgerId                  String?                       @map("custom_ledger_id")
  currency                        String                        @default("CAD")
  issuedAt                        DateTime                      @default(now()) @map("issued_at")
  subtotalAmount                  Decimal                       @default(0) @map("subtotal_amount") @db.Decimal(10, 2)
  discountAmount                  Decimal                       @default(0) @map("discount_amount") @db.Decimal(10, 2)
  taxAmount                       Decimal                       @default(0) @map("tax_amount") @db.Decimal(10, 2)
  taxRatePercent                  Decimal                       @default(0) @map("tax_rate_percent") @db.Decimal(5, 2)
  agencySnapshot                  Json                          @default("{}") @map("agency_snapshot")
  clientSnapshot                  Json                          @default("{}") @map("client_snapshot")
  qbInvoiceId                     String?                       @map("qb_invoice_id")
  qbInvoiceNumber                 String?                       @map("qb_invoice_number")
  qbInvoiceLink                   String?                       @map("qb_invoice_link")
  qbSyncToken                     String?                       @map("qb_sync_token")
  amount                          Decimal                       @db.Decimal(10, 2)
  balance                         Decimal                       @db.Decimal(10, 2)
  status                          String                        @default("Open")
  dueDate                         DateTime?                     @map("due_date")
  lastPaymentMethod               String?                       @map("last_payment_method")
  lastPaymentReference            String?                       @map("last_payment_reference")
  lastPaymentAt                   DateTime?                     @map("last_payment_at")
  lastQbPaymentId                 String?                       @map("last_qb_payment_id")
  creationIdempotencyKey          String?                       @map("creation_idempotency_key")
  lastPaymentIdempotencyKey       String?                       @map("last_payment_idempotency_key")
  createdById                     String?                       @map("created_by_id")
  createdAt                       DateTime                      @default(now()) @map("created_at")
  updatedAt                       DateTime                      @updatedAt @map("updated_at")
  lastSyncedAt                    DateTime?                     @map("last_synced_at")
  agency                          Agency                        @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  customLedger                    AgencyCustomPaymentLedger?    @relation(fields: [customLedgerId], references: [id], onDelete: SetNull)
