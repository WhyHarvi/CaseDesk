generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model ApiRateLimitBucket {
  key       String   @id
  count     Int      @default(1)
  resetAt   DateTime @map("reset_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([resetAt])
  @@map("api_rate_limit_buckets")
}

enum UserRole {
  admin
  consultant
  frontdesk
  client
  staff
  manager
  accountant
}

enum AccountStatus {
  active
  disabled
  invited
  suspended
}

enum AgencyOnboardingStatus {
  pending_setup
  active
  incomplete
  rejected
}

enum AgencyAccessStatus {
  active
  read_only
  blocked
}

enum OnboardingRequestStatus {
  pending
  invited
  completed
  expired
  rejected
  failed
}

enum AssignmentType {
  primary
  supporting
  reviewer
}

enum AssignmentStatus {
  active
  inactive
}

enum ClientStatus {
  Lead
  Active
  Inactive
  Closed
}

enum DocumentStatus {
  Requested
  Uploaded
  UnderReview      @map("Under Review")
  ChangesRequested @map("Changes Requested")
  Approved
  Finalized
  NotRequired      @map("Not Required")
}

enum DocumentVisibility {
  Client
  Internal
}

enum FormStatus {
  Assigned
  InformationMissing @map("Information Missing")
  ReadyToFill        @map("Ready to Fill")
  InProgress         @map("In Progress")
  ReadyForReview     @map("Ready for Review")
  ChangesRequested   @map("Changes Requested")
  Approved
  SignatureRequired  @map("Signature Required")
  Signed
  Finalized
  NotRequired        @map("Not Required")
}

enum FormSource {
  Catalog
  Custom
}

enum FormRequirement {
  Required
  Conditional
  Optional
}

enum FormVersionStatus {
  Unverified
  Current
  UpdateAvailable     @map("Update Available")
  UnsupportedRevision @map("Unsupported Revision")
  SourceUnavailable   @map("Source Unavailable")
  PortalOnly          @map("Portal Only")
}

enum CaseFormVersionSource {
  OfficialImport @map("Official Import")
  CustomUpload   @map("Custom Upload")
  BrowserSave    @map("Browser Save")
  Restored
  Finalized
}

enum FormCopyType {
  Original
  Working
  Filled
  ClientSigned @map("Client Signed")
  Finalized
}

enum CorrespondenceKind {
  Agreement
  Letter
}

enum AppointmentStatus {
  Scheduled
  Completed
  Cancelled
}

enum CommunicationChannel {
  Email
  Sms
  Chat
  Call
}

enum CommunicationDirection {
  Inbound
  Outbound
  Internal
}

enum CommunicationStatus {
  Draft
  Scheduled
  Queued
  Sending
  Sent
  Delivered
  Bounced
  Failed
  Blocked
  OptedOut
  Cancelled
  Received
  Completed
  Missed
}

enum CommunicationConversationState {
  Open
  WaitingOnClient @map("Waiting on Client")
  WaitingOnAgency @map("Waiting on Agency")
  Snoozed
  Closed
}

enum CommunicationPriority {
  Low
  Normal
  High
  Urgent
}

enum CommunicationOutboxStatus {
  Pending
  Processing
  Completed
  Failed
  Cancelled
}

enum CommunicationConsentStatus {
  Unknown
  Consented
  OptedOut  @map("Opted Out")
}

enum CommunicationAttachmentStatus {
  Pending
  Clean
  Rejected
}

enum FollowUpStatus {
  Pending
  Completed
  Overdue
  Cancelled
}

enum PaymentStatus {
  Unpaid
  Partial
  Paid
  Refunded
}

enum CaseWorkflowStepStatus {
  Pending
  Completed
  Cancelled
}

enum WorkflowStepPriority {
  Low
  Normal
  High
  Urgent
}

enum LeadStatus {
  OPEN
  CONVERTED
  LOST
  NURTURE
  DUPLICATE
  DO_NOT_CONTACT
  ARCHIVED
}

enum LeadStage {
  NEW
  ASSIGNED
  CONTACTING
  CONNECTED
  QUALIFIED
  CONSULTATION_BOOKED
  CONSULTATION_COMPLETED
  RETAINER_PENDING
  PAYMENT_PENDING
  READY_TO_CONVERT
}

enum LeadPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum LeadTemperature {
  COLD
  WARM
  HOT
}

enum LeadSourceType {
  PHONE
  OOMA
  WHATSAPP
  FACEBOOK
  INSTAGRAM
  SOCIAL_FORM
  SOCIAL_MESSAGE
  WEBSITE
  GOOGLE_ADS
  EMAIL
  WALK_IN
  REFERRAL
  EVENT
  EMPLOYEE_PHONE
  CSV_IMPORT
  OTHER
}

enum LeadActivityType {
  LEAD_CREATED
  INCOMING_CALL
  OUTGOING_CALL
  MISSED_CALL
  WHATSAPP_RECEIVED
  WHATSAPP_SENT
  SMS_RECEIVED
  SMS_SENT
  EMAIL_RECEIVED
  EMAIL_SENT
  INTERNAL_NOTE
  STAGE_CHANGED
  ASSIGNMENT_CHANGED
  FOLLOW_UP_CREATED
  FOLLOW_UP_COMPLETED
  CONSULTATION_BOOKED
  CONSULTATION_RESCHEDULED
  CONSULTATION_COMPLETED
  CONSULTATION_CANCELLED
  CONSULTATION_NO_SHOW
  AGREEMENT_PREPARED
  AGREEMENT_SENT
  AGREEMENT_SIGNED
  PAYMENT_REQUESTED
  PAYMENT_RECEIVED
  LEAD_CONVERTED
  LEAD_LOST
  LEAD_MOVED_TO_NURTURE
  LEAD_REACTIVATED
  LEAD_MERGED
}

enum LeadActivityDirection {
  INBOUND
  OUTBOUND
  INTERNAL
}

enum LeadActivityChannel {
  PHONE
  OOMA
  WHATSAPP
  SMS
  EMAIL
  SOCIAL
  WEBSITE
  IN_PERSON
  SYSTEM
  OTHER
}

enum LeadFollowUpStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum LeadAssignmentType {
  MANUAL
  ROUND_ROBIN
  RULE_BASED
  REASSIGNMENT
  SYSTEM
}

enum LeadLostReason {
  NO_RESPONSE
  NOT_INTERESTED
  NOT_ELIGIBLE
  PRICE_CONCERN
  SELECTED_ANOTHER_CONSULTANT
  CONSULTATION_NO_SHOW
  AGREEMENT_NOT_SIGNED
  PAYMENT_NOT_COMPLETED
  SERVICE_NOT_OFFERED
  WRONG_CONTACT_INFORMATION
  DUPLICATE
  DO_NOT_CONTACT
  OTHER
}

enum LeadRetainerStatus {
  NOT_REQUIRED
  NOT_PREPARED
  PREPARED
  SENT
  VIEWED
  SIGNED
  DECLINED
  EXPIRED
}

enum LeadInitialPaymentStatus {
  NOT_REQUESTED
  REQUESTED
  PARTIAL
  PAID
  FAILED
  REFUNDED
  WAIVED
}

enum LeadQualificationOutcome {
  QUALIFIED
  MORE_INFORMATION_REQUIRED
  CONSULTATION_REQUIRED
  NOT_ELIGIBLE
  FUTURE_OPPORTUNITY
  SERVICE_NOT_OFFERED
}

enum LeadConsultationStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  RESCHEDULED
  NO_SHOW
}

enum LeadConsultationOutcome {
  READY_TO_PROCEED
  AGREEMENT_REQUIRED
  PAYMENT_REQUIRED
  FOLLOW_UP_REQUIRED
  NOT_ELIGIBLE
  NOT_INTERESTED
  FUTURE_OPPORTUNITY
  LOST
}

enum LeadIncomingEventStatus {
  PENDING
  PROCESSING
  PROCESSED
  DUPLICATE_REVIEW
  FAILED
}

enum LeadImportBatchStatus {
  PREVIEW
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum LeadImportRowStatus {
  VALID
  INVALID
  QUEUED
  PROCESSED
  DUPLICATE
  FAILED
}

enum LeadDuplicateStatus {
  PENDING
  CONFIRMED
  DISMISSED
}

model Agency {
  id                             String                          @id @default(uuid())
  name                           String
  slug                           String?                         @unique
  status                         AccountStatus                   @default(active)
  onboardingStatus               AgencyOnboardingStatus          @default(pending_setup) @map("onboarding_status")
  accessStatus                   AgencyAccessStatus              @default(active) @map("access_status")
  phone                          String?
  email                          String?
  address                        String?
  city                           String?
  province                       String?
  country                        String?
  postalCode                     String?                         @map("postal_code")
  legalName                      String?                         @map("legal_name")
  website                        String?
  logoUrl                        String?                         @map("logo_url")
  businessNumber                 String?                         @map("business_number")
  taxNumber                      String?                         @map("tax_number")
  defaultCurrency                String                          @default("CAD") @map("default_currency")
  locale                         String                          @default("en-CA")
  timezone                       String                          @default("America/Toronto")
  paymentInstructions            String?                         @map("payment_instructions")
  createdAt                      DateTime                        @default(now()) @map("created_at")
  updatedAt                      DateTime                        @updatedAt @map("updated_at")
  users                          User[]
  memberships                    AgencyMember[]
  consultantProfiles             ConsultantProfile[]
  clientUsers                    ClientUser[]
  caseAssignments                CaseAssignment[]
  clients                        Client[]
  cases                          Case[]
  documentTemplates              DocumentTemplate[]
  clientDocuments                ClientDocument[]
  notes                          Note[]
  followUps                      FollowUp[]
  payments                       Payment[]
  activityLogs                   ActivityLog[]
  workflowTemplates              WorkflowTemplate[]
  workflowTemplateSteps          WorkflowTemplateStep[]
  caseWorkflowSteps              CaseWorkflowStep[]
  caseAssessments                CaseAssessment[]
  sharedLibraryDocuments         SharedLibraryDocument[]
  writtenDocuments               WrittenDocument[]
  writtenDocumentVersions        WrittenDocumentVersion[]
  caseForms                      CaseForm[]
  caseFormVersions               CaseFormVersion[]
  caseFormReviewComments         CaseFormReviewComment[]
  agencyFormTemplates            AgencyFormTemplate[]
  agencyFormTemplateVersions     AgencyFormTemplateVersion[]
  formPermissions                FormPermission[]
  caseFormAuditEvents            CaseFormAuditEvent[]
  correspondenceTemplates        CorrespondenceTemplate[]
  correspondenceTemplateVersions CorrespondenceTemplateVersion[]
  appointments                   Appointment[]
  bookingSettings                BookingSettings?
  bookingSessionTypes            BookingSessionType[]
  communicationConversations     CommunicationConversation[]
  communicationMessages          CommunicationMessage[]
  communicationDeliveryEvents    CommunicationDeliveryEvent[]
  communicationOutboxJobs        CommunicationOutbox[]
  communicationPermissions       CommunicationPermission[]
  communicationConsents          CommunicationConsent[]
  communicationTemplates         CommunicationTemplate[]
  communicationUnmatchedItems    UnmatchedCommunication[]
  communicationAuditEvents       CommunicationAuditEvent[]
  communicationAttachments       CommunicationAttachment[]
  communicationRetentionPolicy   CommunicationRetentionPolicy?
  communicationPreferences       CommunicationPreference[]
  communicationAutomationRules   CommunicationAutomationRule[]
  communicationSlaPolicy         CommunicationSlaPolicy?
  clientCommunicationAccesses    ClientCommunicationAccess[]
  immigrationProfiles            ImmigrationProfile[]
  immigrationProfileCaseAccesses ImmigrationProfileCaseAccess[]
  mailSettings                   AgencyMailSettings?
  oomaSettings                   AgencyOomaSettings?
  accountStatements              AccountStatementGeneration[]
  leadSequence                   AgencyLeadSequence?
  clientSequence                 AgencyClientSequence?
  leadSources                    LeadSource[]
  leadCampaigns                  LeadCampaign[]
  leads                          Lead[]
  leadActivities                 LeadActivity[]
  leadStageHistory               LeadStageHistory[]
  leadAssignmentHistory          LeadAssignmentHistory[]
  leadFollowUps                  LeadFollowUp[]
  leadLostDetails                LeadLostDetail[]
  leadConversions                LeadConversion[]
  leadQualifications             LeadQualification[]
  leadConsultations              LeadConsultation[]
  leadIntakeForms                LeadIntakeForm[]
  leadIncomingEvents             LeadIncomingEvent[]
  leadImportBatches              LeadImportBatch[]
  leadImportRows                 LeadImportRow[]
  leadDuplicateCandidates        LeadDuplicateCandidate[]
  leadSourceConnections          LeadSourceConnection[]
  onboardingRequests             OnboardingRequest[]
  notifications                  Notification[]
  notificationPreferences        NotificationPreference[]
  notificationDeliveries         NotificationDelivery[]
  questionnaireAssignments       QuestionnaireAssignment[]

  @@map("agencies")
}

model AgencyMailSettings {
  id                     String    @id @default(uuid())
  agencyId               String    @unique @map("agency_id")
  provider               String    @default("Custom")
  displayName            String?   @map("display_name")
  emailAddress           String    @map("email_address")
  smtpHost               String    @map("smtp_host")
  smtpPort               Int       @map("smtp_port")
  smtpSecure             Boolean   @default(true) @map("smtp_secure")
  smtpUsername           String    @map("smtp_username")
  smtpPasswordEncrypted  String    @map("smtp_password_encrypted")
  imapHost               String?   @map("imap_host")
  imapPort               Int?      @map("imap_port")
  imapSecure             Boolean   @default(true) @map("imap_secure")
  imapUsername           String?   @map("imap_username")
  imapPasswordEncrypted  String?   @map("imap_password_encrypted")
  inboundEnabled         Boolean   @default(false) @map("inbound_enabled")
  lastSyncedUid          BigInt?   @map("last_synced_uid")
  lastInboundSyncAt      DateTime? @map("last_inbound_sync_at")
  lastInboundSyncStatus  String?   @map("last_inbound_sync_status")
  lastInboundSyncMessage String?   @map("last_inbound_sync_message")
  enabled                Boolean   @default(true)
  lastTestedAt           DateTime? @map("last_tested_at")
  lastTestStatus         String?   @map("last_test_status")
  lastTestMessage        String?   @map("last_test_message")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")
  agency                 Agency    @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@index([agencyId])
  @@map("agency_mail_settings")
}

model AgencyOomaSettings {
  id                    String    @id @default(uuid())
  agencyId              String    @unique @map("agency_id")
  apiBaseUrl            String    @map("api_base_url")
  apiKeyEncrypted       String    @map("api_key_encrypted")
  fromNumber            String    @map("from_number")
  smsSendPath           String?   @map("sms_send_path")
  callStartPath         String?   @map("call_start_path")
  authHeader            String    @default("authorization") @map("auth_header")
  authPrefix            String    @default("Bearer") @map("auth_prefix")
  webhookTokenEncrypted String?   @map("webhook_token_encrypted")
  webhookTokenHash      String?   @unique @map("webhook_token_hash")
  lastWebhookAt         DateTime? @map("last_webhook_at")
  enabled               Boolean   @default(true)
  smsEnabled            Boolean   @default(true) @map("sms_enabled")
  callsEnabled          Boolean   @default(true) @map("calls_enabled")
  lastSmsTestedAt       DateTime? @map("last_sms_tested_at")
  lastSmsTestStatus     String?   @map("last_sms_test_status")
  lastSmsTestMessage    String?   @map("last_sms_test_message")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  agency                Agency    @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@index([agencyId])
  @@map("agency_ooma_settings")
}

model User {
  id                                  String                          @id @default(uuid())
  agencyId                            String                          @map("agency_id")
  authUserId                          String?                         @unique @map("auth_user_id") @db.Uuid
  fullName                            String                          @map("full_name")
  email                               String                          @unique
  role                                UserRole
  status                              AccountStatus                   @default(active)
  mustChangePassword                  Boolean                         @default(false) @map("must_change_password")
  phone                               String?
  jobTitle                            String?                         @map("job_title")
  avatarStorageKey                    String?                         @map("avatar_storage_key")
  avatarMimeType                      String?                         @map("avatar_mime_type")
  licenseNumber                       String?                         @map("license_number")
  createdAt                           DateTime                        @default(now()) @map("created_at")
  updatedAt                           DateTime                        @updatedAt @map("updated_at")
  agency                              Agency                          @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  memberships                         AgencyMember[]
  consultantProfiles                  ConsultantProfile[]
  clientUsers                         ClientUser[]
  caseAssignments                     CaseAssignment[]                @relation("AssignedConsultant")
  assignedCaseAssignments             CaseAssignment[]                @relation("CaseAssignmentActor")
  assignedClients                     Client[]                        @relation("AssignedClientUser")
  assignedCases                       Case[]                          @relation("AssignedCaseUser")
  notes                               Note[]
  assignedFollowUps                   FollowUp[]                      @relation("AssignedFollowUpUser")
  activityLogs                        ActivityLog[]
  caseAssessments                     CaseAssessment[]
  uploadedDocuments                   ClientDocument[]                @relation("UploadedDocumentUser")
  reviewedDocuments                   ClientDocument[]                @relation("ReviewedDocumentUser")
  uploadedSharedLibraryDocuments      SharedLibraryDocument[]         @relation("UploadedSharedLibraryUser")
  createdWrittenDocuments             WrittenDocument[]               @relation("CreatedWrittenDocumentUser")
  updatedWrittenDocuments             WrittenDocument[]               @relation("UpdatedWrittenDocumentUser")
  writtenDocumentVersions             WrittenDocumentVersion[]
  uploadedCaseForms                   CaseForm[]                      @relation("UploadedCaseFormUser")
  createdCaseFormVersions             CaseFormVersion[]               @relation("CreatedCaseFormVersionUser")
  createdCaseFormReviewComments       CaseFormReviewComment[]         @relation("CreatedCaseFormReviewCommentUser")
  resolvedCaseFormReviewComments      CaseFormReviewComment[]         @relation("ResolvedCaseFormReviewCommentUser")
  uploadedAgencyFormTemplates         AgencyFormTemplate[]            @relation("UploadedAgencyFormTemplateUser")
  createdAgencyFormTemplateVersions   AgencyFormTemplateVersion[]     @relation("CreatedAgencyFormTemplateVersionUser")
  formPermission                      FormPermission?
  lockedCaseForms                     CaseForm[]                      @relation("LockedCaseFormUser")
  caseFormAuditEvents                 CaseFormAuditEvent[]
  assignedCaseTasks                   CaseWorkflowStep[]              @relation("AssignedCaseTaskUser")
  createdCorrespondenceTemplates      CorrespondenceTemplate[]        @relation("CreatedCorrespondenceTemplateUser")
  updatedCorrespondenceTemplates      CorrespondenceTemplate[]        @relation("UpdatedCorrespondenceTemplateUser")
  correspondenceTemplateVersions      CorrespondenceTemplateVersion[]
  issuedWrittenDocuments              WrittenDocument[]               @relation("IssuedWrittenDocumentUser")
  assignedAppointments                Appointment[]                   @relation("AssignedAppointmentUser")
  createdAppointments                 Appointment[]                   @relation("CreatedAppointmentUser")
  createdCommunicationConversations   CommunicationConversation[]     @relation("CreatedCommunicationConversationUser")
  assignedCommunicationConversations  CommunicationConversation[]     @relation("AssignedCommunicationConversationUser")
  deletedCommunicationConversations   CommunicationConversation[]     @relation("DeletedCommunicationConversationUser")
  sentCommunicationMessages           CommunicationMessage[]          @relation("SenderCommunicationMessageUser")
  deletedCommunicationMessages        CommunicationMessage[]          @relation("DeletedCommunicationMessageUser")
  communicationPermission             CommunicationPermission?
  createdCommunicationTemplates       CommunicationTemplate[]         @relation("CreatedCommunicationTemplateUser")
  updatedCommunicationTemplates       CommunicationTemplate[]         @relation("UpdatedCommunicationTemplateUser")
  uploadedCommunicationAttachments    CommunicationAttachment[]       @relation("UploadedCommunicationAttachmentUser")
  communicationAuditEvents            CommunicationAuditEvent[]
  createdCommunicationAutomationRules CommunicationAutomationRule[]   @relation("CreatedCommunicationAutomationRuleUser")
  updatedCommunicationAutomationRules CommunicationAutomationRule[]   @relation("UpdatedCommunicationAutomationRuleUser")
  createdClientCommunicationAccesses  ClientCommunicationAccess[]     @relation("CreatedClientCommunicationAccessUser")
  generatedAccountStatements          AccountStatementGeneration[]    @relation("GeneratedAccountStatementUser")
  ownedLeads                          Lead[]                          @relation("LeadOwnerUser")
  nextActionLeads                     Lead[]                          @relation("LeadNextActionOwnerUser")
  performedLeadActivities             LeadActivity[]                  @relation("LeadActivityPerformerUser")
  changedLeadStages                   LeadStageHistory[]              @relation("LeadStageActorUser")
  previousLeadAssignments             LeadAssignmentHistory[]         @relation("LeadPreviousOwnerUser")
  newLeadAssignments                  LeadAssignmentHistory[]         @relation("LeadNewOwnerUser")
  assignedLeadChanges                 LeadAssignmentHistory[]         @relation("LeadAssignmentActorUser")
  assignedLeadFollowUps               LeadFollowUp[]                  @relation("LeadFollowUpAssigneeUser")
  completedLeadFollowUps              LeadFollowUp[]                  @relation("LeadFollowUpCompleterUser")
  lostLeads                           LeadLostDetail[]                @relation("LeadLostActorUser")
  convertedLeads                      LeadConversion[]                @relation("LeadConversionActorUser")
  completedLeadQualifications         LeadQualification[]             @relation("LeadQualificationActorUser")
  leadConsultations                   LeadConsultation[]              @relation("LeadConsultantUser")
  createdLeadConsultations            LeadConsultation[]              @relation("LeadConsultationCreatorUser")
  ownedLeadIntakeForms                LeadIntakeForm[]                @relation("LeadIntakeFormOwnerUser")
  uploadedLeadImportBatches           LeadImportBatch[]               @relation("LeadImportUploaderUser")
  ownedLeadSourceConnections          LeadSourceConnection[]          @relation("LeadSourceConnectionOwnerUser")
  onboardingRequests                  OnboardingRequest[]
  receivedNotifications               Notification[]                  @relation("NotificationRecipient")
  actedNotifications                  Notification[]                  @relation("NotificationActor")
  notificationPreferences             NotificationPreference[]
  notificationDeliveries              NotificationDelivery[]

  @@index([agencyId])
  @@index([authUserId])
  @@index([agencyId, status])
  @@map("users")
}

model AgencyMember {
  id                 String   @id @default(uuid())
  agencyId           String   @map("agency_id")
  userId             String   @map("user_id")
  role               UserRole
  isActive           Boolean  @default(true) @map("is_active")
  permissions        Json     @default("{}")
  mustChangePassword Boolean  @default(false) @map("must_change_password")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  agency             Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([agencyId, userId])
  @@index([userId, isActive])
  @@index([agencyId, role, isActive])
  @@map("agency_members")
}

model OnboardingRequest {
  id              String                  @id @default(uuid())
  email           String                  @unique
  fullName        String                  @map("full_name")
  agencyName      String                  @map("agency_name")
  phone           String?
  country         String?
  status          OnboardingRequestStatus @default(pending)
  agencyId        String?                 @map("agency_id")
  userId          String?                 @map("user_id")
  authUserId      String?                 @unique @map("auth_user_id") @db.Uuid
  termsAcceptedAt DateTime                @map("terms_accepted_at")
  invitedAt       DateTime?               @map("invited_at")
  completedAt     DateTime?               @map("completed_at")
  expiresAt       DateTime?               @map("expires_at")
  failureCode     String?                 @map("failure_code")
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")
  agency          Agency?                 @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  user            User?                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, expiresAt])
  @@index([agencyId])
  @@map("onboarding_requests")
}

model ConsultantProfile {
  id                 String   @id @default(uuid())
  agencyId           String   @map("agency_id")
  userId             String   @map("user_id")
  employeeId         String?  @map("employee_id")
  specializations    String[] @default([])
  masteryLevel       String?  @map("mastery_level")
  maximumActiveCases Int      @default(20) @map("maximum_active_cases")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  agency             Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([agencyId, userId])
  @@unique([agencyId, employeeId])
  @@index([agencyId])
  @@map("consultant_profiles")
}

model ClientUser {
  id           String   @id @default(uuid())
  agencyId     String   @map("agency_id")
  clientId     String   @map("client_id")
  userId       String   @map("user_id")
  relationship String?
  isPrimary    Boolean  @default(true) @map("is_primary")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  agency       Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([agencyId, clientId, userId])
  @@index([agencyId, userId])
  @@index([clientId])
  @@map("client_users")
}

model CaseAssignment {
  id               String           @id @default(uuid())
  agencyId         String           @map("agency_id")
  caseId           String           @map("case_id")
  consultantUserId String           @map("consultant_user_id")
  assignmentType   AssignmentType   @default(primary) @map("assignment_type")
  status           AssignmentStatus @default(active)
  assignedById     String?          @map("assigned_by")
  assignedAt       DateTime         @default(now()) @map("assigned_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  agency           Agency           @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  case             Case             @relation(fields: [caseId], references: [id], onDelete: Cascade)
  consultant       User             @relation("AssignedConsultant", fields: [consultantUserId], references: [id], onDelete: Cascade)
  assignedBy       User?            @relation("CaseAssignmentActor", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([agencyId, caseId, consultantUserId, assignmentType])
  @@index([agencyId, consultantUserId, status])
  @@index([caseId, status])
  @@map("case_assignments")
}

model Client {
  id                         String                       @id @default(uuid())
  agencyId                   String                       @map("agency_id")
