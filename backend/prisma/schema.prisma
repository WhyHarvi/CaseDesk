  taxableTaxCodeId      String?  @map("taxable_tax_code_id")
  taxableTaxCodeName    String?  @map("taxable_tax_code_name")
  // Percent, not a fraction (2.99 means 2.99%) — matches how an admin
  // reads it off their QuickBooks Payments account rate. Applied twice
  // when estimating a refund (original charge's fee, never returned, plus
  // a new fee on the refund itself) — see refundFeeEstimateService.js.
  refundFeeRatePercent  Decimal  @default(2.99) @map("refund_fee_rate_percent") @db.Decimal(5, 3)
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")
  agency                Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@map("agency_quickbooks_settings")
}

