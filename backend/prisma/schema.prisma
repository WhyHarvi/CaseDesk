  createdAt DateTime              @default(now()) @map("created_at")
  line      AgencyTwilioVoiceLine @relation(fields: [lineId], references: [id], onDelete: Cascade)
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([lineId, userId])
  @@index([lineId])
  @@map("agency_twilio_voice_line_assignees")
}

model AgencyTwilioSettings {
  id                    String    @id @default(uuid())
