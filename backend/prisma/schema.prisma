// One Twilio phone number configured for voice, with its inbound routing
// rule. FRONTDESK rings frontdesk staff, DIRECT rings its assigned members,
// and STAFF/INTERNAL ring everyone. The INTERNAL line is the office line
// staff dial to reach each other and the number transfers ring from.
model AgencyTwilioVoiceLine {
  id             String   @id @default(uuid())
  agencyId       String   @map("agency_id")
  numberSid      String   @unique @map("number_sid")
  phoneNumber    String   @map("phone_number")
  label          String   @default("Line") @map("label")
  routing        String   @default("STAFF") @map("routing")
  enabled        Boolean  @default(true) @map("enabled")
  isPrimary      Boolean  @default(false) @map("is_primary")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  agency         Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  assignments    AgencyTwilioVoiceLineAssignee[]

  @@index([agencyId])
  @@map("agency_twilio_voice_line")
}

model AgencyTwilioVoiceLineAssignee {
  lineId    String                @map("line_id")
