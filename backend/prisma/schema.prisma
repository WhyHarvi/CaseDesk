model Appointment {
  id                     String                   @id @default(uuid())
  agencyId               String                   @map("agency_id")
  clientId               String?                  @map("client_id")
  caseId                 String?                  @map("case_id")
  leadId                 String?                  @map("lead_id")
  sessionTypeId          String?                  @map("session_type_id")
  subject                String
  location               String?
  // The rendered "name — address" string above is a display snapshot taken
  // at booking time — it doesn't say which BookingSettings.locations[]
  // entry the appointment actually belongs to, so nothing that reschedules
  // this appointment (staff or guest) can know which location's working
  // hours to enforce. Not a relation: locations live as JSON array entries
  // on BookingSettings, not their own table — same pattern as
  // BookingPaymentHold.locationId and BookingWaitlistEntry.locationId.
  locationId             String?                  @map("location_id")
  locationMapsUrl        String?                  @map("location_maps_url")
  calendar               String                   @default("Case Calendar")
  startsAt               DateTime                 @map("starts_at")
  endsAt                 DateTime                 @map("ends_at")
  description            String?
  purpose                String?
  internalNotes          String?                  @map("internal_notes")
  guestName              String?                  @map("guest_name")
  guestEmail             String?                  @map("guest_email")
  guestEmailNormalized   String?                  @map("guest_email_normalized")
  guestPhone             String?                  @map("guest_phone")
  meetingMode            String                   @default("InPerson") @map("meeting_mode")
  meetingUrl             String?                  @map("meeting_url")
  meetingPhoneNumber     String?                  @map("meeting_phone_number")
  meetingProvider        String?                  @map("meeting_provider")
  meetingProviderId      String?                  @map("meeting_provider_id")
  meetingProviderHostId  String?                  @map("meeting_provider_host_id")
  meetingSyncStatus      String                   @default("NotRequired") @map("meeting_sync_status")
  meetingSyncError       String?                  @map("meeting_sync_error")
  manageToken            String?                  @unique @default(uuid()) @map("manage_token")
  reminderSentAt         DateTime?                @map("reminder_sent_at")
  reminderDueAt          DateTime?                @map("reminder_due_at")
  reminderQueuedAt       DateTime?                @map("reminder_queued_at")
  assignedToId           String?                  @map("assigned_to_id")
  createdById            String?                  @map("created_by_id")
  cancelledById          String?                  @map("cancelled_by_id")
  cancelledAt            DateTime?                @map("cancelled_at")
  cancellationReason     String?                  @map("cancellation_reason")
  source                 String                   @default("Internal")
  isFreeConsultation     Boolean                  @default(false) @map("is_free_consultation")
  idempotencyKey         String?                  @map("idempotency_key")
  referenceCode          String?                  @unique @map("reference_code")
  confirmationStatus     String                   @default("Awaiting") @map("confirmation_status")
  confirmedAt            DateTime?                @map("confirmed_at")
  preparationCompletedAt DateTime?                @map("preparation_completed_at")
  seriesKey              String?                  @map("series_key")
  recurrenceIndex        Int?                     @map("recurrence_index")
  recurrenceCount        Int?                     @map("recurrence_count")
  status                 AppointmentStatus        @default(Scheduled)
  createdAt              DateTime                 @default(now()) @map("created_at")
  updatedAt              DateTime                 @updatedAt @map("updated_at")
  agency                 Agency                   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  client                 Client?                  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  case                   Case?                    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  lead                   Lead?                    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  sessionType            BookingSessionType?      @relation(fields: [sessionTypeId], references: [id], onDelete: SetNull)
  assignedTo             User?                    @relation("AssignedAppointmentUser", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy              User?                    @relation("CreatedAppointmentUser", fields: [createdById], references: [id], onDelete: SetNull)
  cancelledBy            User?                    @relation("CancelledAppointmentUser", fields: [cancelledById], references: [id], onDelete: SetNull)
  leadConsultation       LeadConsultation?
  messageDeliveries      BookingMessageDelivery[]
  events                 AppointmentEvent[]
  notes                  Note[]
  followUps              FollowUp[]
  paymentHold            BookingPaymentHold?
  paymentApprovals       PaymentApproval[]
  cashTransactions       CashTransaction[]
  meetingJobs            AppointmentMeetingJob[]
  advice                 AppointmentAdvice?
  calendarSyncs          AppointmentCalendarSync[]
  callSessions           CallSession[]

  @@unique([agencyId, idempotencyKey])
  @@index([agencyId])
  @@index([caseId, startsAt])
  @@index([clientId])
  @@index([assignedToId, startsAt])
  @@index([agencyId, startsAt])
  @@index([agencyId, status, startsAt])
  @@index([agencyId, reminderDueAt, reminderQueuedAt])
  @@index([leadId])
  @@index([agencyId, seriesKey, recurrenceIndex])
  @@index([agencyId, confirmationStatus, startsAt])
  @@index([agencyId, meetingProvider, meetingProviderId])
  @@index([agencyId, createdById, createdAt])
  @@map("appointments")
}

// One row per (appointment, viewer) — an appointment isn't mirrored onto a
// single external event, it's mirrored once per staff member who should see
// it on their own Outlook calendar: the assigned staff member always gets
// one, and an admin who's turned calendar sync on gets one for every
// appointment in the agency, not just their own. Never a meeting invite —
// no attendees are ever added, so nothing emails the client.
model AppointmentCalendarSync {
  id             String       @id @default(uuid())
  appointmentId  String       @map("appointment_id")
  userId         String       @map("user_id")
  calendarEventId String?     @map("calendar_event_id")
  syncStatus     String       @default("NotSynced") @map("sync_status")
  syncedAt       DateTime?    @map("synced_at")
  syncError      String?      @map("sync_error")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  appointment    Appointment  @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([appointmentId, userId])
  @@index([userId, syncStatus])
  @@map("appointment_calendar_syncs")
}

