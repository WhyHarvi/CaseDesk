model CaseInvoice {
  id                   String                   @id @default(uuid())
  agencyId             String                   @map("agency_id")
  caseId               String                   @map("case_id")
  clientId             String                   @map("client_id")
  paymentType          String                   @map("payment_type")
  description          String
  qbInvoiceId          String                   @map("qb_invoice_id")
  qbInvoiceNumber      String?                  @map("qb_invoice_number")
  qbInvoiceLink        String?                  @map("qb_invoice_link")
  qbSyncToken          String                   @map("qb_sync_token")
  amount               Decimal                  @db.Decimal(10, 2)
  balance              Decimal                  @db.Decimal(10, 2)
  status               String                   @default("Open")
  dueDate              DateTime?                @map("due_date")
  lastPaymentMethod    String?                  @map("last_payment_method")
  lastPaymentReference String?                  @map("last_payment_reference")
  lastPaymentAt        DateTime?                @map("last_payment_at")
  lastQbPaymentId      String?                  @map("last_qb_payment_id")
  creationIdempotencyKey String?                @map("creation_idempotency_key")
  lastPaymentIdempotencyKey String?             @map("last_payment_idempotency_key")
  createdById          String?                  @map("created_by_id")
  createdAt            DateTime                 @default(now()) @map("created_at")
  updatedAt            DateTime                 @updatedAt @map("updated_at")
  lastSyncedAt         DateTime                 @map("last_synced_at")
  agency               Agency                   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  case                 Case                     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  client               Client                   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy            User?                    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  installments         CasePaymentInstallment[]
  followUps            FollowUp[]

  @@unique([agencyId, qbInvoiceId])
  @@unique([agencyId, creationIdempotencyKey])
  @@unique([agencyId, lastPaymentIdempotencyKey])
  @@index([agencyId, caseId])
  @@index([agencyId, clientId])
  @@map("case_invoices")
}

// A lightweight, QuickBooks-independent record of money owed/received on a
// case — for amounts staff deliberately don't want flowing into the
// QuickBooks-synced CaseInvoice/CasePaymentInstallment pipeline above (e.g.
// historical admissions fees migrated from an outside spreadsheet). Just
// enough to answer "what came in and what's still owed" without pretending
// to be a real accounting record.
// Attaches to either a Lead (pre-conversion) or a Case+Client (post-
// conversion) — never both. caseId/clientId used to be required back when
// this only tracked converted-client fees; leadId was added so staff can
// start recording "what's paid, what's still owed" during the lead stage
// too, before there's a Case to hang it off of.
model CaseManualLedgerEntry {
  id          String   @id @default(uuid())
  agencyId    String   @map("agency_id")
  leadId      String?  @map("lead_id")
  caseId      String?  @map("case_id")
  clientId    String?  @map("client_id")
  label       String
  amountOwed  Decimal  @default(0) @map("amount_owed") @db.Decimal(10, 2)
  amountPaid  Decimal  @default(0) @map("amount_paid") @db.Decimal(10, 2)
  status      String   @default("Unpaid")
  note        String?
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  agency      Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  lead        Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  case        Case?    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  client      Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([agencyId, leadId])
  @@index([agencyId, caseId])
  @@index([agencyId, clientId])
  @@map("case_manual_ledger_entries")
}

model PaymentScheduleTemplate {
  id           String                               @id @default(uuid())
  agencyId     String                               @map("agency_id")
