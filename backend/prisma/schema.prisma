// Per-field definition for a form template (AgencyFormTemplate) — created
// once by an admin the first time a form is imported and mapped, then
// reused by every case that attaches this form. fieldKey is the raw PDF
// AcroForm field name; sourcePath is resolved against a small whitelisted
// registry in code (client.*, consultant.*, agency.*, case.*) rather than
// arbitrary lookup, so a bad mapping can never leak unrelated data.
model FormTemplateFieldSchema {
  id                   String              @id @default(uuid())
  agencyId             String              @map("agency_id")
  agencyFormTemplateId String              @map("agency_form_template_id")
  fieldKey             String              @map("field_key")
  fieldType            FormFieldType       @default(Text) @map("field_type")
  page                 Int?
  section              String?
  sortIndex            Int                 @default(0) @map("sort_index")
  label                String
  helpText             String?             @map("help_text")
  owner                FormFieldOwner      @default(Manual)
  sourcePath           String?             @map("source_path")
  isRequired           Boolean             @default(false) @map("is_required")
  // { "requiredWhen": { "fieldKey": "purpose", "in": ["appointing"] } } —
  // lets one field's applicability depend on another field's value (e.g.
  // IMM 5476's Section B only applies when the top "purpose" selector is
  // "appointing" or "cancel_and_appoint"). Evaluated generically by the
  // checklist and completeness check — no form-specific code.
  condition            Json?
  fillableBy           FormFieldFillableBy @default(Consultant) @map("fillable_by")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")
  agency               Agency              @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  agencyFormTemplate   AgencyFormTemplate  @relation(fields: [agencyFormTemplateId], references: [id], onDelete: Cascade)

  @@unique([agencyFormTemplateId, fieldKey])
  @@index([agencyId])
  @@index([agencyFormTemplateId])
  @@map("form_template_field_schemas")
}

// The live checklist data for one case's copy of a form. One row per field
// per CaseForm. status drives the checklist's Auto-filled / You filled /
// Client filled / Missing pills. Autofill never overwrites a row that's
// already ConsultantEntered or ClientEntered — editing an auto-filled value
// "pins" it the same way.
model CaseFormFieldValue {
  id         String               @id @default(uuid())
  agencyId   String               @map("agency_id")
  caseFormId String               @map("case_form_id")
  fieldKey   String               @map("field_key")
  value      String?
  status     FormFieldValueStatus @default(Unset)
  filledById String?              @map("filled_by_id")
  filledAt   DateTime?            @map("filled_at")
  createdAt  DateTime             @default(now()) @map("created_at")
  updatedAt  DateTime             @updatedAt @map("updated_at")
  agency     Agency               @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  caseForm   CaseForm             @relation(fields: [caseFormId], references: [id], onDelete: Cascade)
  filledBy   User?                @relation("CaseFormFieldValueFiller", fields: [filledById], references: [id], onDelete: SetNull)

  @@unique([caseFormId, fieldKey])
  @@index([agencyId])
  @@index([caseFormId])
  @@index([filledById])
  @@map("case_form_field_values")
}

// "Send the remaining fields to the client" — the client-portal-facing
// counterpart of QuestionnaireAssignment, scoped to a CaseForm's still-
// missing Client-owned fields instead of a whole questionnaire.
model CaseFormClientRequest {
  id                 String                      @id @default(uuid())
