// Explicit state only — not-applicable overrides and verification. Never
// stores calculated completion/status; that's always derived (see
// sectionCompletionService.js) so it can never drift out of sync with
// the data it's describing.
model CaseInformationSectionState {
  id                  String    @id @default(uuid())
  agencyId            String    @map("agency_id")
  caseId              String    @map("case_id")
  sectionKey          String    @map("section_key")
  // Manual assignment (Phase 6): optional/not_applicable sections are
  // hidden by default until explicitly enabled for this case, or until
  // they already carry real data — see
  // caseInformationWorkspace.js's isSectionVisible(). Required sections
  // ignore this flag entirely; they always show.
  enabled             Boolean   @default(false)
  enabledAt           DateTime? @map("enabled_at")
  enabledById         String?   @map("enabled_by_id")
  notApplicable       Boolean   @default(false) @map("not_applicable")
  notApplicableReason String?   @map("not_applicable_reason")
  verifiedAt          DateTime? @map("verified_at")
  verifiedById        String?   @map("verified_by_id")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  agency              Agency    @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  case                Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  verifiedBy          User?     @relation("CaseInformationSectionStateVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  enabledBy           User?     @relation("CaseInformationSectionStateEnabler", fields: [enabledById], references: [id], onDelete: SetNull)

  @@unique([agencyId, caseId, sectionKey])
  @@map("case_information_section_states")
}

