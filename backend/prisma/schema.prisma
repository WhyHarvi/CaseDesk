  provider               String          @default("TWILIO")
  direction              String
  status                 String
  remoteNumber           String?         @map("remote_number")
  remoteNumberNormalized String?         @map("remote_number_normalized")
  businessNumber         String?         @map("business_number")
  extensionLabel         String?         @map("extension_label")
  handledByUserId        String?         @map("handled_by_user_id")
  clientId               String?         @map("client_id")
  caseId                 String?         @map("case_id")
  leadId                 String?         @map("lead_id")
  appointmentId          String?         @map("appointment_id")
  followUpId             String?         @map("follow_up_id")
  resolution             String          @default("UNRESOLVED")
  disposition            String?
  outcomeNotes           String?         @map("outcome_notes")
  startedAt              DateTime        @map("started_at")
  answeredAt             DateTime?       @map("answered_at")
  endedAt                DateTime?       @map("ended_at")
  durationSeconds        Int?            @map("duration_seconds")
