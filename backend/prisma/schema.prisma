  name         String
  isActive     Boolean                              @default(true) @map("is_active")
  createdAt    DateTime                             @default(now()) @map("created_at")
  updatedAt    DateTime                             @updatedAt @map("updated_at")
  agency       Agency                               @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  installments PaymentScheduleTemplateInstallment[]

  @@index([agencyId, caseType])
  @@map("payment_schedule_templates")
}

model PaymentScheduleTemplateInstallment {
  id                      String                  @id @default(uuid())
  templateId              String                  @map("template_id")
  label                   String
  paymentType             String                  @map("payment_type")
  amount                  Decimal                 @db.Decimal(10, 2)
  triggerType             String                  @map("trigger_type")
  triggerStage            String?                 @map("trigger_stage")
  triggerDaysAfterSigning Int?                    @map("trigger_days_after_signing")
  sortOrder               Int                     @default(0) @map("sort_order")
  template                PaymentScheduleTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@map("payment_schedule_template_installments")
}

model CasePaymentSchedule {
  id           String                   @id @default(uuid())
  agencyId     String                   @map("agency_id")
  caseId       String                   @unique @map("case_id")
  clientId     String                   @map("client_id")
  signingDate  DateTime                 @map("signing_date")
  createdById  String?                  @map("created_by_id")
  createdAt    DateTime                 @default(now()) @map("created_at")
  updatedAt    DateTime                 @updatedAt @map("updated_at")
  agency       Agency                   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  case         Case                     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  client       Client                   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy    User?                    @relation("PaymentScheduleCreator", fields: [createdById], references: [id], onDelete: SetNull)
  installments CasePaymentInstallment[]

  @@index([agencyId])
