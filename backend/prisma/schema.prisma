// Case-side equivalent of LeadStageHistory. Case.stage is otherwise just
// overwritten in place with no audit trail — this exists so a case's
// progress through its stages can be measured after the fact (e.g. for
// timeline-based incentive bonuses), not just observed as its current value.
model CaseStageHistory {
  id            String   @id @default(uuid())
  agencyId      String   @map("agency_id")
  caseId        String   @map("case_id")
  previousStage String?  @map("previous_stage")
  newStage      String   @map("new_stage")
  changedById   String?  @map("changed_by")
  reason        String?
  createdAt     DateTime @default(now()) @map("created_at")
  agency        Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  case          Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  changedBy     User?    @relation("CaseStageActorUser", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([agencyId, caseId, createdAt])
  @@map("case_stage_history")
}

