model BookingPaymentHold {
  id                       String                   @id @default(uuid())
  agencyId                 String                   @map("agency_id")
  assignedToId             String                   @map("assigned_to_id")
  sessionTypeId            String?                  @map("session_type_id")
  startsAt                 DateTime                 @map("starts_at")
  endsAt                   DateTime                 @map("ends_at")
  claimToken               String                   @unique @default(uuid()) @map("claim_token")
  idempotencyKey           String?                  @map("idempotency_key")
  guestName                String                   @map("guest_name")
  guestEmail               String?                  @map("guest_email")
  guestEmailNormalized     String?                  @map("guest_email_normalized")
  guestPhone               String?                  @map("guest_phone")
  meetingMode              String                   @map("meeting_mode")
  meetingPhoneNumber       String?                  @map("meeting_phone_number")
  meetingProvider          String?                  @map("meeting_provider")
  locationId               String?                  @map("location_id")
  location                 String?
  locationMapsUrl          String?                  @map("location_maps_url")
  notes                    String?
  amount                   Decimal                  @db.Decimal(10, 2)
  // Nullable: unset for the brief window between the slot lock committing
  // and the QuickBooks customer/invoice calls completing. Deliberately not
  // NOT NULL — Postgres allows multiple NULLs under a unique index, so two
  // concurrent holds mid-creation never collide on qbInvoiceId.
  qbCustomerId             String?                  @map("qb_customer_id")
  qbInvoiceId              String?                  @map("qb_invoice_id")
  // Human-facing QuickBooks document number (for example, 1006). The QBO
  // entity id above is an internal identifier and should never be shown to
  // staff as the invoice number.
  qbInvoiceNumber          String?                  @map("qb_invoice_number")
  qbInvoiceLink            String?                  @map("qb_invoice_link")
  qbSyncToken              String?                  @map("qb_sync_token")
  qbRefundReceiptId        String?                  @map("qb_refund_receipt_id")
  qbPaymentId              String?                  @map("qb_payment_id")
  paymentMethod            String?                  @map("payment_method")
  manualPaymentNote        String?                  @map("manual_payment_note")
  manualPaymentReference   String?                  @map("manual_payment_reference")
  paymentError             String?                  @map("payment_error")
  status                   String                   @default("AwaitingPayment")
  source                   String                   @default("Public")
  expiresAt                DateTime?                @map("expires_at")
  paidAt                   DateTime?                @map("paid_at")
  voidedAt                 DateTime?                @map("voided_at")
  // Set by the periodic balance-mismatch sweep when a "Paid" hold's real
  // QuickBooks invoice no longer shows a zero balance (or the invoice is
  // gone entirely) — the usual cause is a Payment being deleted in
  // QuickBooks directly rather than properly refunded, which produces no
  // RefundReceipt for the normal refund-matching path to ever see. Cleared
  // automatically if a later sweep finds the balance whole again.
  balanceMismatchAt        DateTime?                @map("balance_mismatch_at")
  voidAttempts             Int                      @default(0) @map("void_attempts")
  nextVoidAttemptAt        DateTime?                @map("next_void_attempt_at")
  // One-time marker: has detectPaidAfterVoidHolds already checked this
  // voided hold's invoice for a payment that landed anyway? Confirmed
  // empirically against real QuickBooks that this is reachable — voiding a
  // paid invoice succeeds, and paying a voided invoice succeeds, so
  // nothing on QuickBooks' own side prevents this race. Set regardless of
  // outcome (found or not) so a genuinely-abandoned hold isn't rechecked
  // forever.
  postVoidPaymentCheckedAt DateTime?                @map("post_void_payment_checked_at")
  appointmentId            String?                  @unique @map("appointment_id")
  // Set when this paid booking is fulfilling a waitlist offer — the offer's
  // own BookingSlotHold can't be claimed (and its BookingWaitlistEntry
  // marked "Booked") until payment actually confirms, which happens later
  // and in a different request (webhook/reconcile), so it has to be
  // persisted here rather than handled inline like the free booking path.
  offerHoldId              String?                  @unique @map("offer_hold_id")
  createdById              String?                  @map("created_by_id")
  // Set by staff bookings and by verified portal/public bookings that match
  // an existing client. The guest* fields remain the booking-time snapshot.
  // Also prevents an expired checkout from becoming a duplicate Lead.
  clientId                 String?                  @map("client_id")
  // Set once an unlinked abandoned (Expired/Voided, never-paid) public hold
  // has been recovered into a Lead. Linked-client holds use an idempotent
  // ActivityLog instead and intentionally leave this null.
  leadId                   String?                  @map("lead_id")
  createdAt                DateTime                 @default(now()) @map("created_at")
  updatedAt                DateTime                 @updatedAt @map("updated_at")
  agency                   Agency                   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  assignedTo               User                     @relation("AssignedBookingPaymentHoldUser", fields: [assignedToId], references: [id], onDelete: Cascade)
  sessionType              BookingSessionType?      @relation(fields: [sessionTypeId], references: [id], onDelete: SetNull)
  appointment              Appointment?             @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  offerHold                BookingSlotHold?         @relation(fields: [offerHoldId], references: [id], onDelete: SetNull)
  createdBy                User?                    @relation("CreatedBookingPaymentHoldUser", fields: [createdById], references: [id], onDelete: SetNull)
