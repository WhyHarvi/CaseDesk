model AutomatedReminderPolicy {
  id              String                      @id @default(uuid())
  agencyId        String                      @map("agency_id")
  kind            AutomatedReminderKind
  enabled         Boolean                     @default(false)
  cadenceDays     Int                         @default(7) @map("cadence_days")
  maxReminders    Int                         @default(3) @map("max_reminders")
  defaultDueDays  Int                         @default(30) @map("default_due_days")
  emailEnabled    Boolean                     @default(true) @map("email_enabled")
  smsEnabled      Boolean                     @default(false) @map("sms_enabled")
  subjectTemplate String                      @map("subject_template")
  messageTemplate String                      @map("message_template")
  smsTemplate     String                      @map("sms_template")
  createdAt       DateTime                    @default(now()) @map("created_at")
  updatedAt       DateTime                    @updatedAt @map("updated_at")
  agency          Agency                      @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  deliveries      AutomatedReminderDelivery[]

  @@unique([agencyId, kind])
  @@index([agencyId, enabled])
  @@map("automated_reminder_policies")
}

model AutomatedReminderDelivery {
  id             String                  @id @default(uuid())
  agencyId       String                  @map("agency_id")
  policyId       String                  @map("policy_id")
  targetId       String                  @map("target_id")
  clientId       String                  @map("client_id")
  sequence       Int
  status         String                  @default("processing")
  attempts       Int                     @default(0)
  effectiveDueAt DateTime                @map("effective_due_at")
  emailSentAt    DateTime?               @map("email_sent_at")
  smsSentAt      DateTime?               @map("sms_sent_at")
  portalSentAt   DateTime?               @map("portal_sent_at")
  sentAt         DateTime?               @map("sent_at")
  nextAttemptAt  DateTime?               @map("next_attempt_at")
  lastError      String?                 @map("last_error")
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")
  agency         Agency                  @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  policy         AutomatedReminderPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@unique([policyId, targetId, sequence])
  @@index([agencyId, status, nextAttemptAt])
  @@index([policyId, targetId, sentAt])
  @@map("automated_reminder_deliveries")
}

model ExpiringDocumentReminderPolicy {
  id              String                             @id @default(uuid())
  agencyId        String                             @map("agency_id")
  documentKey     String                             @map("document_key")
  enabled         Boolean                            @default(false)
