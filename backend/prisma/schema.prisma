  sourceFileHash                 String?                        @map("source_file_hash")
  status                         CaseFormSignatureRequestStatus @default(Sent)
  submissionChannel              CaseFormSubmissionChannel      @default(PortalOrSecureAccount) @map("submission_channel")
  message                        String?
  applicantNameSnapshot          String                         @map("applicant_name_snapshot")
  representativeNameSnapshot     String                         @map("representative_name_snapshot")
  representativeLicenceSnapshot  String                         @map("representative_licence_snapshot")
  representativeSignatureImage   String                         @map("representative_signature_image") @db.Text
  representativeSignatureStrokes Json                           @map("representative_signature_strokes")
  applicantSignatureImage        String?                        @map("applicant_signature_image") @db.Text
  applicantSignatureStrokes      Json?                          @map("applicant_signature_strokes")
  consentedAt                    DateTime?                      @map("consented_at")
  signedAt                       DateTime?                      @map("signed_at")
  signerIp                       String?                        @map("signer_ip")
  signerUserAgent                String?                        @map("signer_user_agent")
  createdById                    String                         @map("created_by_id")
  createdAt                      DateTime                       @default(now()) @map("created_at")
  updatedAt                      DateTime                       @updatedAt @map("updated_at")
  agency                         Agency                         @relation(fields: [agencyId], references: [id], onDelete: Cascade)
