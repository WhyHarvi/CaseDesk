model Note {
  id            String   @id @default(uuid())
  agencyId      String   @map("agency_id")
  clientId      String?  @map("client_id")
  caseId        String?  @map("case_id")
  userId        String?  @map("user_id")
  content       String
  clientVisible Boolean  @default(false) @map("client_visible")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  agency        Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  client        Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  case          Case?    @relation(fields: [caseId], references: [id], onDelete: SetNull)
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([agencyId])
  @@index([clientId])
  @@index([caseId])
  @@index([userId])
  @@map("notes")
}

model FollowUp {
  id                   String         @id @default(uuid())
  agencyId             String         @map("agency_id")
  clientId             String?        @map("client_id")
  caseId               String?        @map("case_id")
  assignedUserId       String?        @map("assigned_user_id")
  title                String
  description          String?
  dueDate              DateTime?      @map("due_date")
  status               FollowUpStatus
  completedAt          DateTime?      @map("completed_at")
  reminderAt           DateTime?      @map("reminder_at")
  notificationChannels String[]       @default(["in_app"]) @map("notification_channels")
  notifyClient         Boolean        @default(false) @map("notify_client")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")
  agency               Agency         @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  client               Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  case                 Case?          @relation(fields: [caseId], references: [id], onDelete: SetNull)
  assignedUser         User?          @relation("AssignedFollowUpUser", fields: [assignedUserId], references: [id], onDelete: SetNull)

  @@index([agencyId])
  @@index([clientId])
  @@index([caseId])
  @@index([assignedUserId])
  @@index([agencyId, status, reminderAt])
  @@map("follow_ups")
}

model Payment {
  id         String        @id @default(uuid())
  agencyId   String        @map("agency_id")
  clientId   String?       @map("client_id")
  caseId     String?       @map("case_id")
  totalFee   Decimal       @map("total_fee") @db.Decimal(10, 2)
  paidAmount Decimal       @map("paid_amount") @db.Decimal(10, 2)
  balance    Decimal       @db.Decimal(10, 2)
  status     PaymentStatus
  currency   String        @default("CAD")
  notes      String?
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")
  agency     Agency        @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  client     Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  case       Case?         @relation(fields: [caseId], references: [id], onDelete: SetNull)

  @@index([agencyId])
  @@index([clientId])
  @@index([caseId])
  @@map("payments")
}

model AccountStatementGeneration {
  id              String    @id @default(uuid())
  sequence        Int       @unique @default(autoincrement())
  statementNumber String    @unique @map("statement_number")
  agencyId        String    @map("agency_id")
  clientId        String    @map("client_id")
  caseId          String?   @map("case_id")
  generatedById   String    @map("generated_by_id")
  dateFrom        DateTime? @map("date_from")
  dateTo          DateTime? @map("date_to")
  currency        String
  generatedAt     DateTime  @default(now()) @map("generated_at")
  agency          Agency    @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  client          Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  case            Case?     @relation(fields: [caseId], references: [id], onDelete: SetNull)
  generatedBy     User      @relation("GeneratedAccountStatementUser", fields: [generatedById], references: [id], onDelete: Restrict)

  @@index([agencyId, clientId, generatedAt])
  @@index([caseId])
  @@map("account_statement_generations")
}

model ActivityLog {
  id         String   @id @default(uuid())
  agencyId   String   @map("agency_id")
  userId     String?  @map("user_id")
  clientId   String?  @map("client_id")
  caseId     String?  @map("case_id")
  action     String
  details    String?
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")
  agency     Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  client     Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  case       Case?    @relation(fields: [caseId], references: [id], onDelete: SetNull)

  @@index([agencyId])
  @@index([userId])
  @@index([clientId])
  @@index([caseId])
  @@index([agencyId, action, createdAt])
  @@map("activity_logs")
}

model AgencyLeadSequence {
  agencyId  String   @id @map("agency_id")
  nextValue Int      @default(1) @map("next_value")
  updatedAt DateTime @updatedAt @map("updated_at")
  agency    Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@map("agency_lead_sequences")
}

model AgencyClientSequence {
  agencyId  String   @id @map("agency_id")
  nextValue Int      @default(1) @map("next_value")
  updatedAt DateTime @updatedAt @map("updated_at")
  agency    Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@map("agency_client_sequences")
}

model LeadSource {
  id             String                 @id @default(uuid())
  agencyId       String                 @map("agency_id")
  name           String
  type           LeadSourceType
  isActive       Boolean                @default(true) @map("is_active")
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")
  agency         Agency                 @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  campaigns      LeadCampaign[]
  leads          Lead[]
  intakeForms    LeadIntakeForm[]
  incomingEvents LeadIncomingEvent[]
  importBatches  LeadImportBatch[]
  connections    LeadSourceConnection[]

  @@unique([agencyId, name])
  @@index([agencyId, type, isActive])
  @@map("lead_sources")
}

model LeadCampaign {
  id             String                 @id @default(uuid())
  agencyId       String                 @map("agency_id")
  sourceId       String                 @map("source_id")
  name           String
  externalId     String?                @map("external_id")
  startDate      DateTime?              @map("start_date")
  endDate        DateTime?              @map("end_date")
  budget         Decimal?               @db.Decimal(12, 2)
  isActive       Boolean                @default(true) @map("is_active")
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")
  agency         Agency                 @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  source         LeadSource             @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  leads          Lead[]
  intakeForms    LeadIntakeForm[]
  incomingEvents LeadIncomingEvent[]
  connections    LeadSourceConnection[]

  @@unique([agencyId, sourceId, name])
  @@index([agencyId, isActive])
  @@index([sourceId])
  @@map("lead_campaigns")
}

model Lead {
  id                       String                   @id @default(uuid())
  agencyId                 String                   @map("agency_id")
  leadNumber               String                   @map("lead_number")
  firstName                String?                  @map("first_name")
  lastName                 String?                  @map("last_name")
  phone                    String?
  phoneNormalized          String?                  @map("phone_normalized")
  email                    String?
  emailNormalized          String?                  @map("email_normalized")
  country                  String?
  province                 String?
  preferredLanguage        String?                  @map("preferred_language")
  currentImmigrationStatus String?                  @map("current_immigration_status")
  immigrationInterest      String?                  @map("immigration_interest")
  status                   LeadStatus               @default(OPEN)
  stage                    LeadStage                @default(NEW)
  priority                 LeadPriority             @default(NORMAL)
  temperature              LeadTemperature          @default(COLD)
  ownerUserId              String                   @map("owner_user_id")
  originalSourceId         String                   @map("original_source_id")
  campaignId               String?                  @map("campaign_id")
  initialMessage           String?                  @map("initial_message")
  estimatedValue           Decimal?                 @map("estimated_value") @db.Decimal(12, 2)
  nextActionType           String?                  @map("next_action_type")
  nextActionDescription    String?                  @map("next_action_description")
  nextActionAt             DateTime?                @map("next_action_at")
  nextActionOwnerId        String?                  @map("next_action_owner_id")
  firstContactDueAt        DateTime?                @map("first_contact_due_at")
  firstContactAt           DateTime?                @map("first_contact_at")
  firstConnectedAt         DateTime?                @map("first_connected_at")
  lastContactAt            DateTime?                @map("last_contact_at")
  retainerStatus           LeadRetainerStatus       @default(NOT_PREPARED) @map("retainer_status")
  initialPaymentStatus     LeadInitialPaymentStatus @default(NOT_REQUESTED) @map("initial_payment_status")
  convertedClientId        String?                  @unique @map("converted_client_id")
  convertedCaseId          String?                  @unique @map("converted_case_id")
  convertedAt              DateTime?                @map("converted_at")
  lostAt                   DateTime?                @map("lost_at")
  nurtureUntil             DateTime?                @map("nurture_until")
  version                  Int                      @default(1)
  createdAt                DateTime                 @default(now()) @map("created_at")
  updatedAt                DateTime                 @updatedAt @map("updated_at")
  deletedAt                DateTime?                @map("deleted_at")
  agency                   Agency                   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  owner                    User                     @relation("LeadOwnerUser", fields: [ownerUserId], references: [id], onDelete: Restrict)
  nextActionOwner          User?                    @relation("LeadNextActionOwnerUser", fields: [nextActionOwnerId], references: [id], onDelete: SetNull)
  originalSource           LeadSource               @relation(fields: [originalSourceId], references: [id], onDelete: Restrict)
  campaign                 LeadCampaign?            @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  convertedClient          Client?                  @relation("LeadConvertedClient", fields: [convertedClientId], references: [id], onDelete: SetNull)
  convertedCase            Case?                    @relation("LeadConvertedCase", fields: [convertedCaseId], references: [id], onDelete: SetNull)
  activities               LeadActivity[]
  stageHistory             LeadStageHistory[]
  assignmentHistory        LeadAssignmentHistory[]
  followUps                LeadFollowUp[]
  lostDetail               LeadLostDetail?
  conversion               LeadConversion?
  qualification            LeadQualification?
  consultations            LeadConsultation[]
  incomingEvents           LeadIncomingEvent[]
  duplicateCandidates      LeadDuplicateCandidate[]
  importedRows             LeadImportRow[]          @relation("LeadImportCreatedLead")

  @@unique([agencyId, leadNumber])
  @@index([agencyId, status])
  @@index([agencyId, stage])
  @@index([agencyId, ownerUserId])
  @@index([agencyId, nextActionAt])
  @@index([agencyId, createdAt])
  @@index([agencyId, phoneNormalized])
  @@index([agencyId, emailNormalized])
  @@index([agencyId, originalSourceId])
  @@index([agencyId, campaignId])
  @@map("leads")
}

model LeadActivity {
  id              String                 @id @default(uuid())
  agencyId        String                 @map("agency_id")
  leadId          String                 @map("lead_id")
  activityType    LeadActivityType       @map("activity_type")
  direction       LeadActivityDirection?
  channel         LeadActivityChannel?
  outcome         String?
  title           String
  description     String?
  durationSeconds Int?                   @map("duration_seconds")
  performedById   String?                @map("performed_by")
  externalId      String?                @map("external_id")
  metadata        Json                   @default("{}")
  occurredAt      DateTime               @default(now()) @map("occurred_at")
  createdAt       DateTime               @default(now()) @map("created_at")
  agency          Agency                 @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  lead            Lead                   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  performedBy     User?                  @relation("LeadActivityPerformerUser", fields: [performedById], references: [id], onDelete: SetNull)

  @@index([agencyId, leadId, occurredAt])
  @@index([agencyId, activityType, occurredAt])
  @@map("lead_activities")
}

model LeadStageHistory {
  id            String     @id @default(uuid())
  agencyId      String     @map("agency_id")
  leadId        String     @map("lead_id")
  previousStage LeadStage? @map("previous_stage")
  newStage      LeadStage  @map("new_stage")
  changedById   String?    @map("changed_by")
  reason        String?
  createdAt     DateTime   @default(now()) @map("created_at")
  agency        Agency     @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  lead          Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  changedBy     User?      @relation("LeadStageActorUser", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([agencyId, leadId, createdAt])
  @@map("lead_stage_history")
}

model LeadAssignmentHistory {
  id              String             @id @default(uuid())
  agencyId        String             @map("agency_id")
  leadId          String             @map("lead_id")
  previousOwnerId String?            @map("previous_owner_id")
  newOwnerId      String             @map("new_owner_id")
  assignedById    String?            @map("assigned_by")
  assignmentType  LeadAssignmentType @default(MANUAL) @map("assignment_type")
  reason          String?
  createdAt       DateTime           @default(now()) @map("created_at")
  agency          Agency             @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  lead            Lead               @relation(fields: [leadId], references: [id], onDelete: Cascade)
  previousOwner   User?              @relation("LeadPreviousOwnerUser", fields: [previousOwnerId], references: [id], onDelete: SetNull)
  newOwner        User               @relation("LeadNewOwnerUser", fields: [newOwnerId], references: [id], onDelete: Restrict)
  assignedBy      User?              @relation("LeadAssignmentActorUser", fields: [assignedById], references: [id], onDelete: SetNull)

  @@index([agencyId, leadId, createdAt])
  @@index([agencyId, newOwnerId, createdAt])
  @@map("lead_assignment_history")
}

model LeadFollowUp {
  id                String             @id @default(uuid())
  agencyId          String             @map("agency_id")
  leadId            String             @map("lead_id")
  assignedUserId    String             @map("assigned_user_id")
  type              String
  description       String
  dueAt             DateTime           @map("due_at")
  status            LeadFollowUpStatus @default(PENDING)
  completedAt       DateTime?          @map("completed_at")
  completedById     String?            @map("completed_by")
  completionOutcome String?            @map("completion_outcome")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  agency            Agency             @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  lead              Lead               @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignedUser      User               @relation("LeadFollowUpAssigneeUser", fields: [assignedUserId], references: [id], onDelete: Restrict)
  completedBy       User?              @relation("LeadFollowUpCompleterUser", fields: [completedById], references: [id], onDelete: SetNull)

  @@index([agencyId, assignedUserId, status, dueAt])
  @@index([agencyId, leadId, dueAt])
  @@map("lead_follow_ups")
}

model LeadLostDetail {
  id                  String         @id @default(uuid())
  agencyId            String         @map("agency_id")
  leadId              String         @unique @map("lead_id")
  reasonCode          LeadLostReason @map("reason_code")
  notes               String?
  lostById            String         @map("lost_by")
  lastContactAt       DateTime?      @map("last_contact_at")
  attemptCount        Int            @default(0) @map("attempt_count")
  reactivationAllowed Boolean        @default(false) @map("reactivation_allowed")
  reactivationAt      DateTime?      @map("reactivation_at")
  createdAt           DateTime       @default(now()) @map("created_at")
  agency              Agency         @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  lead                Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  lostBy              User           @relation("LeadLostActorUser", fields: [lostById], references: [id], onDelete: Restrict)

  @@index([agencyId, reasonCode, createdAt])
  @@map("lead_lost_details")
}

model LeadConversion {
  id             String   @id @default(uuid())
  agencyId       String   @map("agency_id")
  leadId         String   @unique @map("lead_id")
  clientId       String   @map("client_id")
  caseId         String?  @map("case_id")
  convertedById  String   @map("converted_by")
  estimatedValue Decimal? @map("estimated_value") @db.Decimal(12, 2)
  actualValue    Decimal? @map("actual_value") @db.Decimal(12, 2)
  convertedAt    DateTime @default(now()) @map("converted_at")
  createdAt      DateTime @default(now()) @map("created_at")
  agency         Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  lead           Lead     @relation(fields: [leadId], references: [id], onDelete: Restrict)
  client         Client   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  case           Case?    @relation(fields: [caseId], references: [id], onDelete: SetNull)
  convertedBy    User     @relation("LeadConversionActorUser", fields: [convertedById], references: [id], onDelete: Restrict)

  @@index([agencyId, convertedAt])
  @@index([clientId])
  @@index([caseId])
  @@map("lead_conversions")
}

model LeadQualification {
  id                       String                   @id @default(uuid())
  agencyId                 String                   @map("agency_id")
  leadId                   String                   @unique @map("lead_id")
  immigrationService       String?                  @map("immigration_service")
  currentCountry           String?                  @map("current_country")
  currentImmigrationStatus String?                  @map("current_immigration_status")
  statusExpiryDate         DateTime?                @map("status_expiry_date")
  preferredDestination     String?                  @map("preferred_destination")
  education                String?
  workExperience           String?                  @map("work_experience")
  languageTest             String?                  @map("language_test")
  previousRefusals         Boolean?                 @map("previous_refusals")
  familyStatus             String?                  @map("family_status")
  estimatedBudget          Decimal?                 @map("estimated_budget") @db.Decimal(12, 2)
  preferredConsultationAt  DateTime?                @map("preferred_consultation_at")
  urgency                  LeadPriority?
  notes                    String?
  eligibilityConfidence    Int?                     @map("eligibility_confidence")
  outcome                  LeadQualificationOutcome
  completedById            String                   @map("completed_by")
  completedAt              DateTime                 @default(now()) @map("completed_at")
  createdAt                DateTime                 @default(now()) @map("created_at")
  updatedAt                DateTime                 @updatedAt @map("updated_at")
  agency                   Agency                   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  lead                     Lead                     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  completedBy              User                     @relation("LeadQualificationActorUser", fields: [completedById], references: [id], onDelete: Restrict)

  @@index([agencyId, outcome, completedAt])
  @@map("lead_qualifications")
}

model LeadConsultation {
  id                 String                   @id @default(uuid())
  agencyId           String                   @map("agency_id")
  leadId             String                   @map("lead_id")
  consultantUserId   String                   @map("consultant_user_id")
  createdById        String                   @map("created_by_id")
  startAt            DateTime                 @map("start_at")
  endAt              DateTime                 @map("end_at")
  timezone           String                   @default("America/Toronto")
  appointmentType    String                   @map("appointment_type")
  status             LeadConsultationStatus   @default(SCHEDULED)
  fee                Decimal?                 @db.Decimal(10, 2)
  paymentStatus      String                   @default("UNPAID") @map("payment_status")
  confirmationStatus String                   @default("PENDING") @map("confirmation_status")
  reminderStatus     String                   @default("PENDING") @map("reminder_status")
  location           String?
  meetingUrl         String?                  @map("meeting_url")
  outcome            LeadConsultationOutcome?
  notes              String?
  createdAt          DateTime                 @default(now()) @map("created_at")
  updatedAt          DateTime                 @updatedAt @map("updated_at")
  agency             Agency                   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  lead               Lead                     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  consultant         User                     @relation("LeadConsultantUser", fields: [consultantUserId], references: [id], onDelete: Restrict)
  createdBy          User                     @relation("LeadConsultationCreatorUser", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([agencyId, startAt])
  @@index([agencyId, consultantUserId, startAt])
  @@index([agencyId, leadId, startAt])
  @@map("lead_consultations")
}

model LeadIntakeForm {
  id                   String              @id @default(uuid())
  agencyId             String              @map("agency_id")
  sourceId             String              @map("source_id")
  campaignId           String?             @map("campaign_id")
  ownerUserId          String              @map("owner_user_id")
  name                 String
  publicToken          String              @unique @map("public_token")
  isActive             Boolean             @default(true) @map("is_active")
  requireConsent       Boolean             @default(true) @map("require_consent")
  firstResponseMinutes Int                 @default(15) @map("first_response_minutes")
  successMessage       String?             @map("success_message")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")
  agency               Agency              @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  source               LeadSource          @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  campaign             LeadCampaign?       @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  owner                User                @relation("LeadIntakeFormOwnerUser", fields: [ownerUserId], references: [id], onDelete: Restrict)
  incomingEvents       LeadIncomingEvent[]

  @@unique([agencyId, name])
  @@index([agencyId, isActive])
  @@map("lead_intake_forms")
}

model LeadIncomingEvent {
  id                  String                   @id @default(uuid())
  agencyId            String                   @map("agency_id")
  sourceId            String                   @map("source_id")
  campaignId          String?                  @map("campaign_id")
  intakeFormId        String?                  @map("intake_form_id")
  sourceConnectionId  String?                  @map("source_connection_id")
  importBatchId       String?                  @map("import_batch_id")
  importRowId         String?                  @unique @map("import_row_id")
  processedLeadId     String?                  @map("processed_lead_id")
  channel             String
  idempotencyKey      String                   @map("idempotency_key")
  rawPayload          Json                     @map("raw_payload")
  normalizedPayload   Json?                    @map("normalized_payload")
  status              LeadIncomingEventStatus  @default(PENDING)
  attempts            Int                      @default(0)
  maxAttempts         Int                      @default(5) @map("max_attempts")
  availableAt         DateTime                 @default(now()) @map("available_at")
  lockedAt            DateTime?                @map("locked_at")
  processedAt         DateTime?                @map("processed_at")
  lastError           String?                  @map("last_error")
  createdAt           DateTime                 @default(now()) @map("created_at")
  updatedAt           DateTime                 @updatedAt @map("updated_at")
  agency              Agency                   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  source              LeadSource               @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  campaign            LeadCampaign?            @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  intakeForm          LeadIntakeForm?          @relation(fields: [intakeFormId], references: [id], onDelete: SetNull)
  sourceConnection    LeadSourceConnection?    @relation(fields: [sourceConnectionId], references: [id], onDelete: SetNull)
  importBatch         LeadImportBatch?         @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  importRow           LeadImportRow?           @relation(fields: [importRowId], references: [id], onDelete: SetNull)
  processedLead       Lead?                    @relation(fields: [processedLeadId], references: [id], onDelete: SetNull)
  duplicateCandidates LeadDuplicateCandidate[]

  @@unique([agencyId, idempotencyKey])
  @@index([status, availableAt])
  @@index([agencyId, createdAt])
  @@index([sourceConnectionId, createdAt])
  @@map("lead_incoming_events")
}

model LeadSourceConnection {
  id                     String              @id @default(uuid())
  agencyId               String              @map("agency_id")
  sourceId               String              @map("source_id")
  campaignId             String?             @map("campaign_id")
  ownerUserId            String              @map("owner_user_id")
  provider               String              @default("WEBSITE")
  name                   String
  publicToken            String              @unique @map("public_token")
  signingSecretEncrypted String              @map("signing_secret_encrypted")
  accessTokenEncrypted   String?             @map("access_token_encrypted")
  isActive               Boolean             @default(true) @map("is_active")
  firstResponseMinutes   Int                 @default(15) @map("first_response_minutes")
  allowedOrigins         Json                @default("[]") @map("allowed_origins")
  lastEventAt            DateTime?           @map("last_event_at")
  createdAt              DateTime            @default(now()) @map("created_at")
  updatedAt              DateTime            @updatedAt @map("updated_at")
  agency                 Agency              @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  source                 LeadSource          @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  campaign               LeadCampaign?       @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  owner                  User                @relation("LeadSourceConnectionOwnerUser", fields: [ownerUserId], references: [id], onDelete: Restrict)
  incomingEvents         LeadIncomingEvent[]

  @@unique([agencyId, name])
  @@index([agencyId, provider, isActive])
  @@map("lead_source_connections")
}

model LeadImportBatch {
  id             String                @id @default(uuid())
  agencyId       String                @map("agency_id")
  sourceId       String                @map("source_id")
  uploadedById   String                @map("uploaded_by_id")
  fileName       String                @map("file_name")
  status         LeadImportBatchStatus @default(PREVIEW)
  totalRows      Int                   @default(0) @map("total_rows")
  validRows      Int                   @default(0) @map("valid_rows")
  invalidRows    Int                   @default(0) @map("invalid_rows")
  processedRows  Int                   @default(0) @map("processed_rows")
  duplicateRows  Int                   @default(0) @map("duplicate_rows")
  failedRows     Int                   @default(0) @map("failed_rows")
  settings       Json                  @default("{}")
  committedAt    DateTime?             @map("committed_at")
  completedAt    DateTime?             @map("completed_at")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")
  agency         Agency                @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  source         LeadSource            @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  uploadedBy     User                  @relation("LeadImportUploaderUser", fields: [uploadedById], references: [id], onDelete: Restrict)
  rows           LeadImportRow[]
  incomingEvents LeadIncomingEvent[]

  @@index([agencyId, createdAt])
  @@index([agencyId, status])
  @@map("lead_import_batches")
}

model LeadImportRow {
  id               String              @id @default(uuid())
  agencyId         String              @map("agency_id")
  batchId          String              @map("batch_id")
  rowNumber        Int                 @map("row_number")
  rawData          Json                @map("raw_data")
  normalizedData   Json?               @map("normalized_data")
  validationErrors Json                @default("[]") @map("validation_errors")
  status           LeadImportRowStatus
  createdLeadId    String?             @map("created_lead_id")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")
  agency           Agency              @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  batch            LeadImportBatch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  createdLead      Lead?               @relation("LeadImportCreatedLead", fields: [createdLeadId], references: [id], onDelete: SetNull)
  incomingEvent    LeadIncomingEvent?

  @@unique([batchId, rowNumber])
  @@index([agencyId, status])
  @@map("lead_import_rows")
}

model LeadDuplicateCandidate {
  id              String              @id @default(uuid())
  agencyId        String              @map("agency_id")
  incomingEventId String              @map("incoming_event_id")
  candidateLeadId String              @map("candidate_lead_id")
  score           Int
  reasons         Json                @default("[]")
  status          LeadDuplicateStatus @default(PENDING)
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  agency          Agency              @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  incomingEvent   LeadIncomingEvent   @relation(fields: [incomingEventId], references: [id], onDelete: Cascade)
  candidateLead   Lead                @relation(fields: [candidateLeadId], references: [id], onDelete: Cascade)

  @@unique([incomingEventId, candidateLeadId])
  @@index([agencyId, status, createdAt])
  @@map("lead_duplicate_candidates")
}

model QuestionnaireAssignment {
  id           String         @id @default(uuid())
  sourceId     String         @map("source_id")
  agencyId     String         @map("agency_id")
  assessmentId String         @map("assessment_id")
  caseId       String         @map("case_id")
  clientId     String         @map("client_id")
  name         String
  sharing      String         @default("Internal")
  status       String         @default("Assigned")
  dueAt        DateTime?      @map("due_at")
  locked       Boolean        @default(false)
  assignedAt   DateTime       @default(now()) @map("assigned_at")
  submittedAt  DateTime?      @map("submitted_at")
  sourceData   Json           @default("{}") @map("source_data")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  agency       Agency         @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  assessment   CaseAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  case         Case           @relation(fields: [caseId], references: [id], onDelete: Cascade)
  client       Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, sourceId])
  @@index([agencyId, status, dueAt])
  @@index([caseId])
  @@index([clientId])
  @@map("questionnaire_assignments")
}

model Notification {
  id              String                 @id @default(uuid())
  agencyId        String                 @map("agency_id")
  recipientUserId String                 @map("recipient_user_id")
  actorUserId     String?                @map("actor_user_id")
  type            String
  category        String
  title           String
  body            String?
  severity        String                 @default("info")
  entityType      String?                @map("entity_type")
  entityId        String?                @map("entity_id")
  actionUrl       String?                @map("action_url")
  metadata        Json                   @default("{}")
  dedupeKey       String                 @map("dedupe_key")
  readAt          DateTime?              @map("read_at")
  dismissedAt     DateTime?              @map("dismissed_at")
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")
  agency          Agency                 @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  recipient       User                   @relation("NotificationRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)
  actor           User?                  @relation("NotificationActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  deliveries      NotificationDelivery[]

  @@unique([agencyId, recipientUserId, dedupeKey])
  @@index([recipientUserId, dismissedAt, createdAt])
  @@index([recipientUserId, readAt, createdAt])
  @@index([agencyId, category, createdAt])
  @@map("notifications")
}

model NotificationPreference {
  id              String   @id @default(uuid())
  agencyId        String   @map("agency_id")
  userId          String   @map("user_id")
  category        String   @default("all")
  inAppEnabled    Boolean  @default(true) @map("in_app_enabled")
  emailEnabled    Boolean  @default(false) @map("email_enabled")
  smsEnabled      Boolean  @default(false) @map("sms_enabled")
  dueSoonMinutes  Int      @default(1440) @map("due_soon_minutes")
  quietHoursStart String?  @map("quiet_hours_start")
  quietHoursEnd   String?  @map("quiet_hours_end")
  timezone        String   @default("America/Toronto")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  agency          Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@index([agencyId])
  @@map("notification_preferences")
}

model NotificationDelivery {
  id              String       @id @default(uuid())
  agencyId        String       @map("agency_id")
  notificationId  String       @map("notification_id")
  recipientUserId String       @map("recipient_user_id")
  channel         String
  status          String       @default("pending")
  attempts        Int          @default(0)
  maxAttempts     Int          @default(5) @map("max_attempts")
  availableAt     DateTime     @default(now()) @map("available_at")
  sentAt          DateTime?    @map("sent_at")
  deliveredAt     DateTime?    @map("delivered_at")
  failedAt        DateTime?    @map("failed_at")
  providerId      String?      @map("provider_id")
  lastError       String?      @map("last_error")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  agency          Agency       @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  notification    Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  recipient       User         @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@unique([notificationId, channel])
  @@index([status, availableAt])
  @@index([recipientUserId, createdAt])
  @@map("notification_deliveries")
}
