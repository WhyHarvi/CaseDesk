  transcript             String?
  lastEventAt            DateTime        @map("last_event_at")
  resolvedAt             DateTime?       @map("resolved_at")
  resolvedById           String?         @map("resolved_by_id")
  rawPayload             Json            @default("{}") @map("raw_payload")
  createdAt              DateTime        @default(now()) @map("created_at")
