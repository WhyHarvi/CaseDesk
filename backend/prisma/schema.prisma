  senderUserId      String?                        @map("sender_user_id")
  senderAddress     String?                        @map("sender_address")
  recipients        Json                           @default("[]")
  cc                Json                           @default("[]")
  bcc               Json                           @default("[]")
  replyTo           String?                        @map("reply_to")
  subject           String?
  bodyText          String?                        @map("body_text")
  bodyHtml          String?                        @map("body_html")
  provider          String?
  providerMessageId String?                        @map("provider_message_id")
  idempotencyKey    String?                        @map("idempotency_key")
  parentMessageId   String?                        @map("parent_message_id")
  emailMessageId    String?                        @map("email_message_id")
  emailInReplyTo    String?                        @map("email_in_reply_to")
  emailReferences   Json                           @default("[]") @map("email_references")
  occurredAt        DateTime                       @default(now()) @map("occurred_at")
  scheduledAt       DateTime?                      @map("scheduled_at")
  sentAt            DateTime?                      @map("sent_at")
  deliveredAt       DateTime?                      @map("delivered_at")
  failedAt          DateTime?                      @map("failed_at")
  failureReason     String?                        @map("failure_reason")
  durationSeconds   Int?                           @map("duration_seconds")
  callDisposition   String?                        @map("call_disposition")
  callRecordingUrl  String?                        @map("call_recording_url")
  callTranscript    String?                        @map("call_transcript")
  attachments       Json                           @default("[]")
  metadata          Json                           @default("{}")
  isRead            Boolean                        @default(true) @map("is_read")
  deletedAt         DateTime?                      @map("deleted_at")
  deletedById       String?                        @map("deleted_by_id")
  createdAt         DateTime                       @default(now()) @map("created_at")
  updatedAt         DateTime                       @updatedAt @map("updated_at")
  agency            Agency                         @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  client            Client                         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  case              Case?                          @relation(fields: [caseId], references: [id], onDelete: Cascade)
  conversation      CommunicationConversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderUser        User?                          @relation("SenderCommunicationMessageUser", fields: [senderUserId], references: [id], onDelete: SetNull)
  deletedBy         User?                          @relation("DeletedCommunicationMessageUser", fields: [deletedById], references: [id], onDelete: SetNull)
  parentMessage     CommunicationMessage?          @relation("CommunicationMessageReplies", fields: [parentMessageId], references: [id], onDelete: SetNull)
  replies           CommunicationMessage[]         @relation("CommunicationMessageReplies")
  deliveryEvents    CommunicationDeliveryEvent[]
  outboxJobs        CommunicationOutbox[]
  attachmentRecords CommunicationAttachment[]
  reactions         CommunicationMessageReaction[]

  @@unique([agencyId, idempotencyKey])
  @@unique([agencyId, provider, providerMessageId])
  @@index([agencyId])
  @@index([caseId, occurredAt])
  @@index([conversationId, occurredAt])
  @@index([clientId])
  @@index([channel])
  @@index([status])
  @@index([providerMessageId])
  @@index([scheduledAt, status])
  @@index([deletedAt])
  @@map("communication_messages")
}

