enum CaseFormSignatureRequestStatus {
  Sent
  Signing
  Signed
  Cancelled
}

enum CaseFormSubmissionChannel {
  PortalOrSecureAccount
  OutsidePortal
}

// A signature request is intentionally separate from the generic missing-
// field request. The client can only draw in the portal; the rest of the
// government form is never exposed as editable input.
model CaseFormSignatureRequest {
  id                             String                         @id @default(uuid())
  agencyId                       String                         @map("agency_id")
  caseFormId                     String                         @map("case_form_id")
  caseId                         String                         @map("case_id")
